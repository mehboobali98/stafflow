<div class="row">
  <div class="col-3">
    <%= link_to 'Back', members_path, class: 'btn btn-dark m-3' %>
  </div>
  <div class="col-6">
    <div class="card text-center w-75 m-2">
      <h2 class='card-header'>Employee Profile</h2>
      <div class="card-body">
        <h3><%= @user.first_name + ' ' + @user.last_name %></h3>
        <h4><%= @user.email %></h4>
        <h4><%= @user.date_of_birth %></h4>
      </div>
    </div>
  </div>
  <div class="col-3 text-end">
    <%= link_to 'Edit', edit_member_path(@user), class: 'btn btn-dark m-3' %>
  </div>
</div>
