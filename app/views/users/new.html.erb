<div class='d-flex justify-content-around'>
  <div class='pb-3 w-75 m-4'>
    <h1 class='mt-3'><%= t('headings.create_employee') %></h1>
    <hr>
    <div>
      <%= form_with model: @user, url: members_path, local: true, id: 'new_employee_form' do |form| %>
        <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li> <%= message %> </li>  
        <% end %>
        </ul>
        <div class='row'>
          <div class='col-6'>
            <div class='field mb-2'>
              <%= form.label t('forms.labels.email') %><br />
              <%= form.email_field :email, class: 'form-control', required: true %>
            </div>
            
            <div class='field mb-2'>
              <%= form.label t('forms.labels.password') %>
              <% if @minimum_password_length %>
                <em>(<%= @minimum_password_length %> characters minimum)</em>
              <% end %><br />
              <%= form.password_field :password, required: true, class: 'form-control' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.confirm_password') %><br />
              <%= form.password_field :password_confirmation, required: true, class: 'form-control' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.fname') %><br />
              <%= form.text_field :first_name, required: true, class: 'form-control', id: 'first_name' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.lname') %><br />
              <%= form.text_field :last_name, required: true, class: 'form-control' %>
            </div>
            <div class='field mb-2'>
              <%= form.label t('forms.labels.gender') %>
              <%= form.select :gender, options_for_select(User::GENDERS), { prompt: t('forms.labels.gender') }, class: 'form-control' %>
            </div>
          </div>
          <div class='col-6'>
            <div class='field mb-2'>
              <%= form.label t('forms.labels.dob') %><br/>
              <%= form.date_field :date_of_birth, required: true, class: 'form-control' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.role') %><br />
              <%= form.select :role_id, options_for_select(user_roles_except_admin), {}, class: 'form-control' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.department') %><br />
              <%= form.select :department_id, options_from_collection_for_select(@departments, 'id', 'name'), { prompt: t('forms.labels.department') }, class: 'form-control', id: 'department_select' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.designation') %><br />
              <%= form.select :designation_id, {}, { prompt: t('forms.labels.designation') }, class: 'form-control', id: 'designation_select' %>
            </div>

            <div class='field mb-2'>
              <%= form.label t('forms.labels.salary') %><br />
              <%= form.number_field :base_salary, required: true, class: 'form-control', min: 0, step: 0.5 %>
            </div>
            <div>
            <div class='field mb-2'>
              <%= form.label t('forms.labels.country') %><br />
              <%= form.select :country, options_for_select(COUNTRIES_LIST), { prompt: t('forms.labels.country')  }, class: 'form-control' %>
            </div>
            </div>
          </div>
        <div class='actions mt-2'>
          <%= form.submit t('forms.buttons.create'), class: 'card-link btn btn-primary w-100' %>
        </div>
      </div>
      <% end %>
    </div>
  </div>
</div>