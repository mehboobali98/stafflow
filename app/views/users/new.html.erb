<div class="card border-dark pb-3 text-center w-25">
  <h1 class= "card-header">Create A New Employee</h1>
  <div class="card-body px-5">


    <%= form_with model: @user, local: true do |form| %>

      <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li> <%= message %> </li>  
      <% end %>
      </ul>


      <div class="field mb-2">
        <%= form.label I18n.t 'forms.labels.email' %><br />
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control pl-5 pr-5'  %>
      </div>
      
      <div class="field mb-2">
        <%= form.label I18n.t 'forms.labels.password' %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
        <% end %><br />
        <%= form.password_field :password, autocomplete: "new-password", class: 'form-control pl-5 pr-5' %>
      </div>

      <div class="field mb-2">
        <%= form.label I18n.t 'forms.labels.confirm_password' %><br />
        <%= form.password_field :password_confirmation, class: 'form-control pl-5 pr-5' %>
      </div>

      <div class="field mb-2">
        <%= form.label I18n.t 'forms.labels.fname' %><br />
        <%= form.text_field :first_name, class: 'form-control pl-5 pr-5' %>
      </div>

      <div class="field mb-2">
        <%= form.label I18n.t 'forms.labels.lname' %><br />
        <%= form.text_field :last_name, class: 'form-control pl-5 pr-5' %>
      </div>

      <div class="field mb-2">
        <%= form.label I18n.t 'forms.labels.dob' %><br />
        <%= form.date_field :date_of_birth, class: 'form-control pl-5 pr-5' %>
      </div>

      <div class="field mb-2">
        <%= form.label :Role %><br />
        <%= form.select :role_id, options_for_select(User::ROLES.invert), class: 'form-select' %>
      </div>


      <div class="actions">
        <%= form.submit I18n.t 'forms.buttons.signup', html: {class: "btn btn-primary"} %>
      </div>

    <% end %>
  </div>
</div>

<%= link_to 'Back', users_path %>