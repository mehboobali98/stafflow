<% content_for :title, t('headings.create_employee') %>
<%= render(PageHeaderComponent.new(title: t('headings.create_employee'))) %>

<%= form_with model: @user, url: members_path, local: true, id: 'new_employee_form',
              data: { controller: 'dependent-select',
                      dependent_select_url_value: fetch_designations_department_path('VALUE') } do |form| %>
  <%= render(CardComponent.new) do %>
    <div class='row'>
      <div class='col-md-6'>
        <%= render(FormFieldComponent.new(form: form, attribute: :email, as: :email_field,
                                          label: t('forms.labels.email'), required: true)) %>
        <%= render(FormFieldComponent.new(form: form, attribute: :first_name,
                                          label: t('forms.labels.fname'), required: true,
                                          id: 'first_name')) %>
        <%= render(FormFieldComponent.new(form: form, attribute: :last_name,
                                          label: t('forms.labels.lname'), required: true)) %>
        <%= render(FormFieldComponent.new(form: form, attribute: :gender,
                                          label: t('forms.labels.gender'))) do %>
          <%= form.select :gender, options_for_select(genders),
                          { prompt: t('forms.labels.gender') }, class: 'form-select' %>
        <% end %>
        <%= render(FormFieldComponent.new(form: form, attribute: :date_of_birth, as: :date_field,
                                          label: t('forms.labels.dob'), required: true)) %>
      </div>
      <div class='col-md-6'>
        <%= render(FormFieldComponent.new(form: form, attribute: :role_id,
                                          label: t('forms.labels.role'))) do %>
          <%= form.select :role_id, options_for_select(user_roles_except_admin), {},
                          class: 'form-select' %>
        <% end %>
        <%= render(FormFieldComponent.new(form: form, attribute: :department_id,
                                          label: t('forms.labels.department'),
                                          id: 'department_select')) do %>
          <%= form.select :department_id,
                          options_from_collection_for_select(@departments, 'id', 'name'),
                          { prompt: t('forms.labels.department') },
                          class: 'form-select', id: 'department_select',
                          data: { action: 'change->dependent-select#load' } %>
        <% end %>
        <%= render(FormFieldComponent.new(form: form, attribute: :designation_id,
                                          label: t('forms.labels.designation'),
                                          id: 'designation_select')) do %>
          <%= form.select :designation_id, {}, { prompt: t('forms.labels.designation') },
                          class: 'form-select', id: 'designation_select',
                          data: { dependent_select_target: 'select' } %>
        <% end %>
        <%= render(FormFieldComponent.new(form: form, attribute: :base_salary, as: :number_field,
                                          label: t('forms.labels.salary'), required: true,
                                          min: 0, step: 0.5)) %>
        <%= render(FormFieldComponent.new(form: form, attribute: :country,
                                          label: t('forms.labels.country'))) do %>
          <%= form.select :country, options_for_select(COUNTRIES_LIST),
                          { prompt: t('forms.labels.country') }, class: 'form-select' %>
        <% end %>
      </div>
    </div>
    <%= form.submit t('forms.buttons.create'), class: 'btn btn-primary w-100 mt-2' %>
  <% end %>
<% end %>
