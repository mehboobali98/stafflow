<h1 class='mb-3 card-header'><%= t('headings.all_employees') %></h1>
<div class='container'>
  <%= link_to t('headings.create_employee'), new_member_path, class: 'btn btn-outline-primary' if can?(:create, User) %>
  <br><br>
  <div class='card-header mb-3 row'>
    <%= form_tag members_path, format: :js, method: :get, remote: true, id: 'filter_form' do %>
      <%= select_tag :department_id, options_from_collection_for_select(@departments, 'id', 'name'), prompt: t('forms.labels.department'), class: 'form-control w-25 d-inline m-1 js-filter-select' %>
      <%= text_field_tag :match_users_name, '', class: 'form-control w-25 d-inline m-1 js-filter-select', placeholder: t('forms.labels.name') %>
      <%= select_tag :role_id, options_for_select(User::ROLES), prompt: t('forms.labels.role'), class: 'form-control w-25 d-inline m-1 js-filter-select' %>
      <%= submit_tag t('forms.buttons.reset_filters'), id: 'reset_filter_btn', remote: true, class: 'btn btn-primary d-inline m-1' %>
    <% end %>
  </div>
  <br>
  <div id='users_table'>
    <%= render partial: 'users_list', locals: { users: @users } %>
  </div>
</div>
