<div class='container'>
  <h1><%= t('headings.all_employees') %></h1>
  <%= link_to t('headings.create_employee'), new_member_path, class: 'btn btn-outline-dark' if can?(:create, User) %>
  <br><br>
  <div class='card-header mb-3 row'>
    <%= form_tag filtered_members_path, format: :js, method: :get, remote: true do %>
      <%= select_tag :department_id, options_for_select({dev: 1, hr: 2}), prompt: t('forms.labels.department'), class: 'form-control w-25 d-inline m-1' %>
      <%= text_field_tag :fname, '', class: 'form-control w-25 d-inline m-1', placeholder: t('forms.labels.name') %>
      <%= select_tag :role_id, options_for_select(User::ROLES), prompt: t('forms.labels.role'), class: 'form-control w-25 d-inline m-1' %>
      <%= submit_tag t('forms.buttons.apply_filters'), remote: true, class: 'btn btn-dark d-inline' %>
      <%= submit_tag t('forms.buttons.reset_filters'), formaction: members_path, remote: true, class: 'btn btn-dark d-inline m-1' %>
    <% end %>
  </div>
  <br>
  <table class='table table-striped table-hover'>
    <thead class='table-dark'>
      <th><%= t('forms.labels.full_name') %></th>
      <th><%= t('forms.labels.email') %></th>
      <th></th>
    </thead>
    <tbody id='users_table'>
      <%= render partial: 'users', locals: { users: @users } %>
    </tbody>
  </table>
  <!-- This line below is temporary for testing -->
  <%= link_to 'Logout', destroy_user_session_path, method: :delete %> 
</div> 