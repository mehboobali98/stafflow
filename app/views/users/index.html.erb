<h1>All Employees</h1>
<% @users.each do |user| %>
  <h1><%= user.first_name %> <%= link_to 'Edit', edit_user_path(user) %> <%= link_to 'Destroy', user_path(user) , method: :delete, data: {confirm: 'Are you sure?'} %> <%= link_to 'Details', user_path(user) %> </h1>
<% end %>

<%= link_to 'New Employee', new_user_path %>