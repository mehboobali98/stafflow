<div class='stafflow-heading p-4'>
  <div class='row'>
    <div class='col-10'>
      <h2><%= t('headings.all_employees') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('headings.create_employee'), new_member_path, class: 'btn btn-primary mt-1' if can?(:create, User) %>
    </div>
  </div>
</div>
<div class='me-3 ms-2'>
  <br><br>
  <%= turbo_frame_tag 'users_table', data: { turbo_action: 'advance' } do %>
    <div class='mb-3'>
      <%= form_tag members_path, method: :get, id: 'filter_form',
                                 data: { controller: 'auto-submit' } do %>
        <div class='row ms-3'>
          <div class='col-10'>
            <%= select_tag :department_id,
                           options_from_collection_for_select(@departments, 'id', 'name', params[:department_id]),
                           prompt: t('forms.labels.department'),
                           class: 'form-control w-25 d-inline m-1 js-filter-select',
                           data: { action: 'change->auto-submit#submit' } %>
            <%= text_field_tag :match_users_name, params[:match_users_name],
                               class: 'form-control w-25 d-inline m-1 js-filter-select',
                               placeholder: t('forms.labels.name'),
                               data: { action: 'input->auto-submit#submit' } %>
            <%= select_tag :role_id, options_for_select(user_roles, params[:role_id]),
                           prompt: t('forms.labels.role'),
                           class: 'form-control w-25 d-inline m-1 js-filter-select',
                           data: { action: 'change->auto-submit#submit' } %>
          </div>
          <div class='col-2'>
            <%= link_to t('forms.buttons.reset_filters'), members_path,
                        id: 'reset_filter_btn', class: 'btn btn-primary d-inline ms-5' %>
          </div>
        </div>
      <% end %>
    </div>
    <br>
    <div id='users_table_rows'>
      <%= render partial: 'users_list', locals: { users: @users } %>
    </div>
  <% end %>
</div>
