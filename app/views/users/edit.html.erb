<div class='d-flex justify-content-around'> 
  <div class='pb-3 w-50 m-4'>
    <h1><%= I18n.t('headings.edit_employee') %></h1>
    <hr>
    <div>
      <%= form_with model: @user, local: true, url: member_path do |form| %>
        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.fname') %><br />
          <%= form.text_field :first_name, required: true, class: 'form-control' %>
        </div>

        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.lname') %><br />
          <%= form.text_field :last_name, required: true, class: 'form-control' %>
        </div>

        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.dob') %><br />
          <%= form.date_field :date_of_birth, required: true, class: 'form-control' %>
        </div>
        <div class='field mb-2'>
          <%= form.label t('forms.labels.gender') %>
          <%= form.select :gender, options_for_select(User::GENDERS), { prompt: t('forms.labels.gender') }, class: 'form-control' %>
        </div>
        <div class='field mb-2'>
          <%= form.label t('forms.labels.country') %><br />
          <%= form.select :country, options_for_select(COUNTRIES_LIST), { prompt: t('forms.labels.country')  }, class: 'form-control' %>
        </div>
        <% if !@user.account_owner? %>
          <% if can?(:update, @user, :role_id) %>
            <div class='field mb-3'>
              <%= form.label I18n.t('forms.labels.role') %><br />
              <%= form.select :role_id, options_for_select(user_roles_except_admin), {}, class: 'form-control' %>
            </div>
          <% end %>
          <% if can?(:update, @user, :department_id) %>
            <div class='field mb-2'>
              <%= form.label I18n.t('forms.labels.department') %><br />
              <%= form.select :department_id, options_from_collection_for_select(@departments, 'id', 'name'), { prompt: t('forms.labels.department') }, class: 'form-control', id: 'department_select' %>
            </div>
          <% end %>
          <% if can?(:update, @user, :designation_id) %>
            <div class='field mb-2'>
              <%= form.label I18n.t('forms.labels.designation') %><br />
              <%= form.select :designation_id, options_from_collection_for_select(@designations, 'id', 'name'), { prompt: t('forms.labels.designation') }, class: 'form-control', id: 'designation_select' %>
            </div>
          <% end %>
          <% if can?(:update, @user, :base_salary) %>
            <div class='field mb-2'>
              <%= form.label I18n.t('forms.labels.salary') %><br />
              <%= form.number_field :base_salary, required: true, class: 'form-control' %>
            </div>
          <% end %>
        <% end %>
        <div class='actions'>
          <%= form.submit t('forms.buttons.update'), class: 'btn btn-primary w-100 mt-3' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
