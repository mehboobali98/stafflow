<%= javascript_pack_tag 'user', 'data-turbolinks-track': 'reload' %>
<div class='d-flex justify-content-around'> 
  <div class='pb-3 w-50 m-4'>
    <h1><%= I18n.t('headings.edit_employee') %></h1>
    <hr>
    <div>
      <%= form_with model: @user, url: member_path do |form| %>
        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.fname') %><br />
          <%= form.text_field :first_name, required: true, class: 'form-control' %>
        </div>

        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.lname') %><br />
          <%= form.text_field :last_name, required: true, class: 'form-control' %>
        </div>

        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.dob') %><br />
          <%= form.date_field :date_of_birth, required: true, class: 'form-control' %>
        </div>
        <% if can?(:update_role, @user, current_user) %>
          <div class='field mb-3'>
            <%= form.label I18n.t('forms.labels.role') %><br />
            <%= form.select :role_id, options_for_select(User::ROLES.except(:account_owner)), {}, class: 'form-control' %>
          </div>
        <% end %>
        <% if can?(:update_department, @user, current_user) %>
          <div class='field mb-2'>
            <%= form.label I18n.t('forms.labels.role') %><br />
            <%= form.select :department_id, options_from_collection_for_select(@departments, 'id', 'name'), { prompt: 'Select Department' },  class: 'form-control', id: 'department_select' %>
          </div>
        <% end %>
        <% if can?(:update_designation, @user, current_user) %>
          <div class='field mb-2'>
            <%= form.label I18n.t('forms.labels.role') %><br />
            <%= form.select :designation_id, {}, { prompt: 'Select Designation' },  class: 'form-control', id: 'designation_select' %>
          </div>
        <% end %>
        <% if can?(:update_salary, @user, current_user) %>
          <div class='field mb-2'>
            <%= form.label I18n.t('forms.labels.salary') %><br />
            <%= form.number_field :base_salary, required: true, class: 'form-control' %>
          </div>
        <% end %>

        <div class='actions'>
          <%= form.submit t('forms.buttons.update'), class: 'btn btn-primary w-100 mt-3' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
