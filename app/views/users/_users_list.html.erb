<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('forms.labels.full_name') %></th>
      <th><%= t('forms.labels.department') %></th>
      <th><%= t('forms.labels.email') %></th>
      <th><%= t('forms.labels.role') %></th>
      <th class="text-end"><%= t('forms.labels.actions') %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% users.each do |user| %>
      <tr>
        <td><%= user.full_name %></td>
        <td><%= user.department.name unless user.department.nil? %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td class="text-end text-nowrap">
          <% if can?(:read, user) %>
            <%= link_to member_path(user), 'aria-label': t('user.links.view') do %>
              <%= render(IconComponent.new(:'eye', size: :lg)) %>
            <% end %>
          <% end %>
          <% if can?(:update, user) %>
            <%= link_to edit_member_path(user), class: 'ms-3', 'aria-label': t('user.links.edit') do %>
              <%= render(IconComponent.new(:'list')) %>
            <% end %>
          <% end %>
          <% if can?(:destroy, user) %>
            <%= link_to member_path(user), class: 'ms-3', 'aria-label': t('user.links.delete'),
                                           data: { turbo_method: :delete,
                                                   turbo_confirm: t('messages.confirmation') } do %>
              <%= render(IconComponent.new(:'trash')) %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<% if users.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
<div class='pagination-wrapper'>
  <%= will_paginate users, container: false %>
</div>
