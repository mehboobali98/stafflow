<table class='table table-hover'>
  <thead class='pms-table-header p-3 table-borderless'>
    <th><%= t('forms.labels.full_name') %></th>
    <th><%= t('forms.labels.department') %></th>
    <th><%= t('forms.labels.email') %></th>
    <th><%= t('forms.labels.actions') %></th>
  </thead>
  <tbody>
    <% users.each do |user| %>
      <tr>
        <td><%= user.full_name %></td>
        <td><%= user.department.name unless user.department.nil? %></td>
        <td><%= user.email %></td>
        <td>
          <% if can?(:read, user) %>
            <%= link_to member_path(user) do %>
              <i class='fa fa-eye fa-lg'></i>
            <% end %>
          <% end %>

          <% if can?(:update, user) %>
            <%= link_to edit_member_path(user) do %>
              <i class='fa fa-bars ms-3'></i>
            <% end %>
          <% end %>

          <% if can?(:destroy, user) %>
            <%= link_to member_path(user), method: :delete, data: { confirm: t('messages.confirmation') } do %>
              <i class='fa fa-trash ms-3'></i>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if users.empty? %>
  <div class="d-flex justify-content-md-center align-items-center mt-5">
    <h1 class='text-muted'><%= t('nodata') %></h1>
  </div>
<% end %>

<div class='js-pagination-wrapper pagination-wrapper'>
  <%= will_paginate users, container: false %>
</div>
