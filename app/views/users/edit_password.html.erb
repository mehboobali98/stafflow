<% content_for :title, t('headings.change_password') %>
<%= render(PageHeaderComponent.new(title: t('headings.change_password'))) %>

<%= form_with model: @user, local: true, url: update_password_members_path, method: :post do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :current_password, as: :password_field,
                                      label: t('forms.labels.current_password'), required: true)) %>
    <%= error_messages(:current_password) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :password, as: :password_field,
                                      label: t('forms.labels.new_password'), required: true)) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :password_confirmation,
                                      as: :password_field,
                                      label: t('forms.labels.confirm_password'), required: true)) %>
    <%= error_messages(:password_confirmation) %>
    <%= render(ButtonComponent.new(type: 'submit')) { t('forms.buttons.update') } %>
  <% end %>
<% end %>
