<div class='d-flex justify-content-around'> 
  <div class='pb-3 w-50 m-4'>
    <h1><%= I18n.t('headings.change_password') %></h1>
    <hr>
    <div>
      <%= form_with model: @user, local: true, url: update_password_members_path, method: :post, class: 'card bg-light p-4' do |form| %>
        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.current_password') %><br />
          <%= error_messages(:current_password) %>
          <%= form.password_field :current_password, required: true, class: 'form-control' %>
        </div>
        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.new_password') %><br />
          <%= form.password_field :password, required: true, class: 'form-control' %>
        </div>
        <div class='field mb-3'>
          <%= form.label I18n.t('forms.labels.confirm_password') %><br />
          <%= error_messages(:password_confirmation) %>
          <%= form.password_field :password_confirmation, required: true, class: 'form-control' %>
        </div>
        <div class='actions'>
          <%= form.submit t('forms.buttons.update'), class: 'btn btn-primary w-100 mt-3' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
