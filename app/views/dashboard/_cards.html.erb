<div class="container-fluid mt-2">
  <div class="row">
    <div class="col-xl-3">
      <div class="card">
        <div class="card-header">
          <h3 class="text-center">Total Events</h3>
        </div>
        <div class="card-body">
          <p class="text-center text-info"><%= @current_company.events.size %></p>
        </div>
        <div class="card-footer text-center">
          <span class="text-black">Upcoming events: </span>
          <span class="text-danger"><%= @current_company.events.where('starts_at > ?', DateTime.now).size %></span>
        </div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="card">
        <div class="card-header">
          <h3 class="text-center">Total Employees</h3>
        </div>
        <div class="card-body">
          <p class="text-center text-secondary"><%= @current_company.users.all.size %></p>
        </div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="card card-danger">
        <div class="card-header">
          <h3 class="text-center">Total Departments</h3>
        </div>
        <div class="card-body">
          <p class="text-center text-primary"><%= @current_company.departments.all.size %></p>
        </div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="card card-danger">
        <div class="card-header">
          <h3 class="card-title">Total Departments</h3>
        </div>
        <div class="card-body">
        </div>
      </div>
    </div>
  </div>
</div>