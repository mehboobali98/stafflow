<div class="container-fluid mt-2">
  <div class="row">
    <div class="col-xl-3">
      <div class="card">
        <div class="card-header">
          <h3 class="text-center">Upcoming Events</h3>
        </div>
        <div class="card-body">
          <p class="text-center text-info"><%= Event.where('starts_at > ?', DateTime.now).size %></p>
        </div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="card">
        <div class="card-header">
          <h3 class="text-center">Total Employees</h3>
        </div>
        <div class="card-body">
          <p class="text-center text-secondary"><%= User.all.size %></p>
        </div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="card card-danger">
        <div class="card-header">
          <h3 class="text-center">Total Departments</h3>
        </div>
        <div class="card-body">
          <p class="text-center text-primary"><%= Department.all.size %></p>
        </div>
      </div>
    </div>
    <div class="col-xl-3">
      <div class="card card-danger">
        <div class="card-header">
          <h3 class="card-title">Total Departments</h3>
        </div>
        <div class="card-body">
        </div>
      </div>
    </div>
  </div>
</div>