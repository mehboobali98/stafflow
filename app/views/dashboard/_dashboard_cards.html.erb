<div class="row g-3">
  <div class="col-md-4">
    <%= render(CardComponent.new(class: 'h-100')) do |card| %>
      <% card.with_header { t('cards.total_events') } %>
      <p class="stat-figure text-info fs-1"><%= events_count %></p>
      <% card.with_footer do %>
        <span><%= t('cards.upcoming_events') %>:</span>
        <span class="fw-semibold"><%= upcoming_events_count %></span>
      <% end %>
    <% end %>
  </div>
  <div class="col-md-4">
    <%= render(CardComponent.new(class: 'h-100')) do |card| %>
      <% card.with_header { t('cards.total_employees') } %>
      <p class="stat-figure text-secondary"><%= users_count %></p>
    <% end %>
  </div>
  <div class="col-md-4">
    <%= render(CardComponent.new(class: 'h-100')) do |card| %>
      <% card.with_header { t('cards.total_departments') } %>
      <p class="stat-figure text-primary"><%= departments_count %></p>
    <% end %>
  </div>
</div>
