<div class="container-fluid mt-2">
  <div class="row">
    <div class="col-xl-6">
      <div class="card card-primary">
        <div class="card-header">
          <h3 class="card-title">Department Employees</h3>
        </div>
        <div class="card-body">
          <div class="chart">
            <%= pie_chart @current_company.departments.joins(:users).group(:name).count %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-xl-6">
      <div class="card card-danger">
        <div class="card-header">
          <h3 class="card-title">Department employees</h3>
        </div>
        <div class="card-body">
          <%= bar_chart @current_company.departments.joins(:users).group(:name).count %>
        </div>
      </div>
    </div>
  </div>
</div>