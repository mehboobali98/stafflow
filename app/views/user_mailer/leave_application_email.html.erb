<h1>Hello There !</h1>
<h3>This email is to inform you that a leave has been requested by <%= @user.full_name %></h3>
<h2>Details:</h2>
<h4>From: <%= @leave.applied_from.strftime("%A, %d %B, %Y") %></h4>
<h4>To <%= @leave.applied_till.strftime("%A, %d %B, %Y") %></h4>
<h4>Duration: <%= @leave.leave_duration_type %></h4>