<table class="table table-hover">
  <thead class="stafflow-table-header">
    <tr>
      <th><%= t('user_leave.headings.leave_type') %></th>
      <th><%= t('user_leave.headings.leave_count') %></th>
      <th><%= t('user_leave.headings.leave_remaining_count') %></th>
      <th><%= t('user_leave.headings.options') %></th>
    </tr>
  </thead>
  <tbody>
    <% user_leaves.each do |user_leave| %>
      <tr>
        <td><%= user_leave.leave.name %></td>
        <td><%= user_leave.total_count %></td>
        <td><%= user_leave.remaining_count %></td>
        <td>
        <% if can?(:show, user_leave) %>
          <%= link_to member_user_leave_path(@user, user_leave) do %>
            <i class='fa fa-eye fa-lg'></i>
          <% end %>
        <% end %>
        <% if can?(:edit, user_leave) %>
          <%= link_to edit_member_user_leave_path(@user, user_leave), remote: true do %>
            <i class='fa fa-bars ms-3'></i>
          <% end %>
        <% end %>
        <% if can?(:destroy, user_leave) %>
          <%= link_to member_user_leave_path(@user, user_leave), method: :delete, data: { confirm: t('user_leave.messages.confirmation.delete') } do %>
            <i class='fa fa-trash ms-3'></i>
          <% end %>
        <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<div class='pagination-wrapper'>
  <%= will_paginate @user_leaves, container: false %>
</div>