<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th><%= t('user_leave.headings.leave_type') %></th>
      <th><%= t('user_leave.headings.leave_count') %></th>
      <th><%= t('user_leave.headings.leave_remaining_count') %></th>
      <th class="text-center" colspan="3"><%= t('user_leave.headings.options') %></th>
    </tr>
  </thead>
  <tbody>
    <% user_leaves.each do |user_leave| %>
      <tr>
        <td><%= user_leave.leave.name %></td>
        <td><%= user_leave.total_count %></td>
        <td><%= user_leave.remaining_count %></td>
        <td><%= link_to t('user_leave.headings.show'), member_user_leave_path(@user, user_leave), class: "btn btn-info" if can?(:show, user_leave) %></td>
        <td><%= link_to t('user_leave.headings.edit'), edit_member_user_leave_path(@user, user_leave), class: "btn btn-secondary", remote: true if can?(:edit, user_leave) %></td>
        <td><%= link_to t('user_leave.headings.delete'), member_user_leave_path(@user, user_leave), method: :delete, data: { confirm: t('user_leave.messages.confirmation.delete') }, class: 'btn btn-danger' if can?(:destroy, user_leave) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<div class='pagination-wrapper'>
  <%= will_paginate @user_leaves, container: false %>
</div>