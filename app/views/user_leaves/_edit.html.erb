<%= form_with model: user_leave, local:true, html: { class: 'card p-3 bg-light' } do |form| %>
  <div class="form-group mb-3">
    <%= form.label :leave_name, t('leave.forms.labels.name'), class: 'text-grey-darkest' %>
    <%= form.text_field :leave_name, readonly: true, class: 'form-control' %>
  </div>
  <div class="form-group mb-3">
    <%= form.label :total_count, t('leave.forms.labels.count'), class: 'text-grey-darkest' %>
    <%= form.number_field :count, in: 1..20, required: true, readonly: true, class: 'form-control', placeholder: t('leave.forms.placeholders.count') %>
  </div>
  <div class="form-group mb-3">
    <%= form.label :remaining_count, t('leave.forms.labels.count'), class: 'text-grey-darkest' %>
    <%= form.number_field :remaining_count, in: 1..20, required: true, class: 'form-control', placeholder: t('leave.forms.placeholders.count') %>
  </div>
<% end %>