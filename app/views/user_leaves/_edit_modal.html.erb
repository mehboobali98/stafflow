<%= form_with scope: :user_leave, url: member_user_leave_path(user, user_leave), method: :patch do |form| %>
  <%= render(ModalComponent.new(title: t('user_leave.headings.edit_user_leave'))) do |modal| %>
    <% modal.with_messages { render partial: 'shared/flash_message' } %>
    <% modal.with_body do %>
      <%= render(FormFieldComponent.new(form: form, attribute: :leave_name,
                                        label: t('leave.forms.labels.name'),
                                        disabled: true, value: user_leave.leave.name)) %>
      <%= render(FormFieldComponent.new(form: form, attribute: :total_count, as: :number_field,
                                        label: t('leave.forms.labels.count'), required: true,
                                        in: MIN_LEAVE_COUNT..MAX_LEAVE_COUNT,
                                        step: LEAVE_COUNT_SCALE)) %>
    <% end %>
    <% modal.with_footer do %>
      <%= render(ButtonComponent.new(variant: :secondary,
                                     data: { action: 'click->modal#close' })) do %>
        <%= t('user_leave.headings.close') %>
      <% end %>
      <%= render(ButtonComponent.new(type: 'submit')) { t('form.button.submit') } %>
    <% end %>
  <% end %>
<% end %>
