<%= javascript_include_tag "user_leaves" %>
<div class="modal-dialog">
  <div class="modal-content">
    <div class="modal-header">
      <h5 class="modal-title"><%= t('user_leave.headings.edit_user_leave') %></h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div id="modal_flash_message"></div>
    <%= form_with scope: :user_leave, url: member_user_leave_path(user, user_leave), method: :patch, local: false, html: { class: 'card p-3 bg-light' } do |form| %>
      <div class="modal-body">
        <div class="form-group mb-3">
          <%= form.label :leave_name, t('leave.forms.labels.name'), class: 'text-grey-darkest' %>
          <%= form.text_field :leave_name, disabled: true, value: user_leave.leave.name, class: 'form-control' %>
        </div>
        <div class="form-group mb-3">
          <%= form.label :total_count, t('leave.forms.labels.count'), class: 'text-grey-darkest' %>
          <%= form.number_field :total_count, in: MIN_LEAVE_COUNT..MAX_LEAVE_COUNT, required: true, step: LEAVE_COUNT_SCALE, class: 'form-control' %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('user_leave.headings.close') %></button>
        <%= form.submit class: 'card-link btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>