<% content_for :title, t('user_leave.headings.add_user_leave') %>
<%= render(PageHeaderComponent.new(title: t('user_leave.headings.add_user_leave'))) %>

<% if @available_leaves.present? %>
  <%= form_tag mass_create_member_user_leaves_path(@user), method: :post do %>
    <%= render(TableComponent.new(class: 'table-hover')) do |table| %>
      <% table.with_head do %>
        <tr>
          <th><%= t('users_benefit.table.select') %></th>
          <th><%= t('user_leave.headings.leave_type') %></th>
          <th><%= t('user_leave.headings.leave_count') %></th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% @available_leaves.each do |leave| %>
          <tr data-controller="toggle-field">
            <td><%= check_box_tag "leave[#{leave.id}][leave_id]", leave.id, false,
                                  class: 'js-available-user-leave form-check-input',
                                  data: { action: 'change->toggle-field#toggle' } %></td>
            <td><%= leave.name %></td>
            <td><%= number_field_tag "leave[#{leave.id}][total_count]", leave.default_count,
                                     disabled: true, class: "js-leave-count-#{leave.id} form-control w-auto",
                                     data: { 'toggle-field-target': 'field' } %></td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
    <% if can?(:create, UserLeave) %>
      <%= render(ButtonComponent.new(type: 'submit')) { t('user_leave.buttons.add_leaves') } %>
    <% end %>
  <% end %>
<% else %>
  <%= render(EmptyStateComponent.new(title: t('user_leave.messages.info.no_leave_remaining'))) %>
<% end %>
