<%= javascript_pack_tag "user_leaves/user_leave" %>
<%= form_tag user_leaves_create_path, method: :post do %>
  <table>
    <tr>
      <th></th>
      <th> Leave type </th>
      <th> Count </th>
    </tr>
    <% @leave.each do |leave| %>
      <tr>
        <td><%= check_box_tag "leave[#{leave.id}][selected]", leave.id %></td>
        <td><%= leave.name %></td>
        <td><%= number_field_tag "leave[#{leave.id}][count]", leave.count, disabled: true %></td>
      </tr>
    <% end %>
  </table>
  <%= submit_tag 'Add user leaves' %>
<% end %>