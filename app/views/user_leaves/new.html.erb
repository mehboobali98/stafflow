<%= javascript_pack_tag "user_leaves" %>
<%= render partial: 'shared/leave_navbar' %>
<div class="container mt-2">
  <%= form_tag member_user_leaves_path(@user), method: :post do %>
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th></th>
          <th><%= t('user_leave.headings.leave_type') %></th>
          <th><%= t('user_leave.headings.leave_count') %></th>
        </tr>
      </thead>
      <tbody>
        <% @leave.each do |leave| %>
          <tr>
            <td><%= check_box_tag "user_leave[leave][#{leave.id}][leave_id]", leave.id, false, data: { "id": "js-leave-count-#{leave.id}" } %></td>
            <td><%= leave.name %></td>
            <td><%= number_field_tag "user_leave[leave][#{leave.id}][total_count]", leave.count, disabled: true, class: "js-leave-count-#{leave.id}" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= submit_tag t('user_leave.buttons.add_leaves'), class: 'btn btn-primary' %>
  <% end %>
</div>