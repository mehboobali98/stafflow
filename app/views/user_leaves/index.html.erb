<div class="container">
  <h1><%= t('user_leave.headings.user_leaves') %></h1>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th><%= t('user_leave.headings.leave_type') %></th>
        <th><%= t('user_leave.headings.leave_count') %></th>
        <th><%= t('user_leave.headings.leave_remaining_count') %></th>
        <th class="text-center" colspan="3"><%= t('user_leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody id="user_leaves_table">
      <%= render partial: 'user_leaves_table', locals: { user_leaves: @user_leaves } %>
    </tbody>
  </table>
</div>
<div class='pagination-wrapper'>
  <%= will_paginate @user_leaves, container: false %>
</div>