<% content_for :title, t('user_leave.headings.user_leaves') %>
<%= render(PageHeaderComponent.new(title: t('user_leave.headings.user_leaves'))) do |header| %>
  <% if can?(:create, AppliedLeave) %>
    <% header.with_actions do %>
      <%= render(ButtonComponent.new(href: new_member_applied_leave_path(current_user))) do %>
        <%= t('applied_leave.links.apply_for_leave') %>
      <% end %>
    <% end %>
  <% end %>
  <% header.with_link { link_to t('leave.all'), leaves_path } %>
  <% unless current_user.account_owner? %>
    <% header.with_link { link_to t('user_leave.myappleaves'), member_applied_leaves_path(current_user) } %>
    <% header.with_link { link_to t('user_leave.myavleaves'), member_user_leaves_path(current_user) } %>
  <% end %>
<% end %>

<%= turbo_frame_tag 'user_leaves_list' do %>
  <%= render partial: 'user_leaves_list', locals: { user_leaves: @user_leaves } %>
  <% if @user_leaves.empty? %>
    <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
  <% end %>
<% end %>
