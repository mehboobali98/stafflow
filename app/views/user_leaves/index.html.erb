<div class='pms-heading ms-1'>
  <div class='row'>
    <div class='col-10'>
      <h2 class="mb-3"><%= t('user_leave.headings.user_leaves') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('applied_leave.links.apply_for_leave'), new_member_applied_leave_path(current_user), class: 'btn btn-primary mb-2' if can?(:create, AppliedLeave) %>
    </div>
  </div>
  <%= link_to "All Leaves", leaves_path, class: 'card-link' %>  
  <% unless current_user.account_owner? %>
      <%= link_to "My Applied Leaves", member_applied_leaves_path(current_user), class: 'card-link' %>
      <%= link_to "My Available Leaves", member_user_leaves_path(current_user), class: 'card-link' %> 
  <% end %>
</div>
<br><br>
<div>
  <table class="table table-hover">
    <thead class="pms-table-header">
      <tr>
        <th><%= t('user_leave.headings.leave_type') %></th>
        <th><%= t('user_leave.headings.leave_count') %></th>
        <th><%= t('user_leave.headings.leave_remaining_count') %></th>
        <th><%= t('user_leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody id="user_leaves_table">
      <%= render partial: 'user_leaves_table', locals: { user_leaves: @user_leaves } %>
    </tbody>
  </table>
</div>