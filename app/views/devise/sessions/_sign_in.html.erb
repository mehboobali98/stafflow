<div class='d-flex justify-content-around'>
  <div class='card p-5 w-50 mt-5'>
    <div class='row px-5'>
      <div class='col-12 d-flex justify-content-start'>
        <h4 class='border border-primary rounded bg-primary text-white p-2'><%= t('labels.ems') %></h4>
        <h5 class='mt-3 ms-2 text-muted'><%= t('labels.byteam') %></h5>
      </div>
    </div>
    <hr>
    <div class='card-body px-5'>
      <h3 class= 'mb-4'><%= t('labels.signin') %></h3>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
        <div class="row mb-2">
          <div class='col-3 mt-2'>
            <%= form.label t('forms.labels.email', class: 'form-label') %><br />
          </div>
          <div class='col-9'>
            <%= form.email_field :email, required: true, class: 'form-control', value: params.dig(:email) %>
          </div>
        </div>

        <div class="row mb-2">
          <div class='col-3 mt-2'>
            <%= form.label t('forms.labels.password') %>
          </div>
          <div class='col-9'>
            <%= form.password_field :password, required: true, class: 'form-control' %>
          </div>
        </div>
        <% if devise_mapping.rememberable? %>
          <div class="mt-4 mb-2">
            <%= form.check_box :remember_me, class: 'form-check-input' %>
            <%= form.label t('forms.labels.remember_me')%>
          </div>
        <% end %>
        <div class="mb-2">
          <%= form.submit t('forms.buttons.signin'), class: 'btn btn-primary w-100 p-2' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
