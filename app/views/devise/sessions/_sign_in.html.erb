<h3 class='mb-4'><%= t('labels.signin') %></h3>
<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
  <%= render(FormFieldComponent.new(form: form, attribute: :email, as: :email_field,
                                    label: t('forms.labels.email'), required: true,
                                    value: params[:email])) %>
  <%= error_messages(:email) %>
  <%= render(FormFieldComponent.new(form: form, attribute: :password, as: :password_field,
                                    label: t('forms.labels.password'), required: true)) %>
  <%= error_messages(:password) %>
  <% if devise_mapping.rememberable? %>
    <div class="form-check mb-3">
      <%= form.check_box :remember_me, class: 'form-check-input' %>
      <%= form.label :remember_me, t('forms.labels.remember_me'), class: 'form-check-label' %>
    </div>
  <% end %>
  <%= render(ButtonComponent.new(type: 'submit', class: 'w-100')) { t('forms.buttons.signin') } %>
<% end %>
<%= render "devise/shared/links" %>
