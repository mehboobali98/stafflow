<h3><%= t('labels.signin') %></h3>
<%= form_for(resource, as: resource_name, url: display_companies_home_index_url, method: :get) do |form| %>
  <%= render(FormFieldComponent.new(form: form, attribute: :email, as: :email_field,
                                    label: t('forms.labels.email'), required: true)) %>
  <%= render(ButtonComponent.new(type: 'submit', class: 'w-100')) do %>
    <%= t('forms.buttons.search_company') %>
  <% end %>
<% end %>
<div class='text-center'>
  <%= link_to t('forms.buttons.signup'), new_registration_path(resource_name), class: 'text-center mt-2' %>
</div>
