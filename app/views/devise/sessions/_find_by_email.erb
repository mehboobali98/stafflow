<div class='d-flex justify-content-around'>
  <div class='card p-5 w-50 mt-5'>
    <div class='row px-5'>
      <div class='col-12 d-flex justify-content-start'>
        <h4 class='border border-primary rounded bg-primary text-white p-2'><%= t('labels.ems') %></h4>
        <h5 class='mt-3 ms-2 text-muted'><%= t('labels.byteam') %></h5>
      </div>
    </div>
    <hr>
    <div class='card-body px-5'>
      <h3><%= t('labels.signin') %></h3>
        <%= form_for(resource, as: resource_name, url: display_companies_home_index_url, method: :get) do |form| %>
          <div class='row mb-2 mt-4'>
            <div class='col-4 mt-1'>
              <%= form.label t('forms.labels.email'), class: 'form-label' %>
            </div>
            <div class='col-8'>
              <%= form.email_field :email, required: true, class: 'form-control pl-5 pr-5' %>
            </div>
          </div>
          <div class='actions'>
            <%= form.submit t('forms.buttons.search_company'), class: 'btn btn-primary w-100 mt-2 mb-2' %>
          </div>
        <% end %>
        <div class='text-center'>
          <%= link_to t('forms.buttons.signup'), new_registration_path(resource_name), class: 'text-center mt-2' %>
        </div>
    </div>
  </div>
</div>
