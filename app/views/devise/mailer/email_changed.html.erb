<p><%= I18n.t('messages.hello', user_email: @email) %>!</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= I18n.t('messages.email_changed_unconfirmed', email: @resource.unconfirmed_email) %>.</p>
<% else %>
  <p><%= I18n.t('messages.email_changed_confirmed', email: @resource.email) %>.</p>
<% end %>
