<p> <%= I18n.t('messages.hello', user_email: @email) %>!</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p> <%= I18n.t('messages.email_change_uncomfirmed', email: @resource.unconfirmed_email)  %>.</p>
<% else %>
  <p> <%= I18n.t('messages.email_change_comfirmed', email: @resource.email) %>.</p>
<% end %>
