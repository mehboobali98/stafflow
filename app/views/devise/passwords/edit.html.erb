<% content_for :title, t('headings.change_password') %>
<h3 class='mb-4'><%= t('headings.change_password') %></h3>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |form| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= form.hidden_field :reset_password_token %>
  <%= render(FormFieldComponent.new(form: form, attribute: :password, as: :password_field,
                                    label: t('forms.labels.password'), required: true, autofocus: true,
                                    hint: @minimum_password_length &&
                                          t('forms.hints.minimum_password_length',
                                            count: @minimum_password_length))) %>
  <%= render(FormFieldComponent.new(form: form, attribute: :password_confirmation, as: :password_field,
                                    label: t('forms.labels.confirm_password'), required: true)) %>
  <%= render(ButtonComponent.new(type: 'submit', class: 'w-100')) do %>
    <%= t('forms.buttons.change_password') %>
  <% end %>
<% end %>
<%= render "devise/shared/links" %>
