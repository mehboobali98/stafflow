<h2> <%= I18n.t 'headings.signup'%> </h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label I18n.t 'forms.labels.email' %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label I18n.t 'forms.labels.password' %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label I18n.t 'forms.labels.confirm_password' %><br />
    <%= f.password_field :password_confirmation %>
  </div>

  <div class="field">
    <%= f.label I18n.t 'forms.labels.fname' %><br />
    <%= f.text_field :first_name %>
  </div>

   <div class="field">
    <%= f.label I18n.t 'forms.labels.lname' %><br />
    <%= f.text_field :last_name %>
  </div>

   <div class="field">
    <%= f.label I18n.t 'forms.labels.dob' %><br />
    <%= f.date_field :date_of_birth %>
  </div>

    <%= f.fields_for :company, Company.new do |form|%>
      <div class="field">
        <%= form.label :Company %><br />
        <%= form.text_field :name %>
      </div>

      
    <%end%>

  <div class="actions">
    <%= f.submit I18n.t 'forms.buttons.signup' %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
