<div class='row vh-100 w-100'>
  <div class='col-lg-6 col-md-12 d-flex align-items-center justify-content-center'>
    <div class='w-75'>
      <h2><%= t('headings.signup') %></h2>
      <hr>
      <div>
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                     html: { data: { controller: 'subdomain' } }) do |f| %>
          <%= error_messages(:first_name) %>
          <div class="form-floating mb-2">
            <%= f.text_field :first_name, required: true, class: 'form-control', placeholder: t('forms.labels.fname') %>
            <%= f.label :first_name, t('forms.labels.fname') + '*' %>
          </div>
          <%= error_messages(:last_name) %>
          <div class="form-floating mb-2">
            <%= f.text_field :last_name, required: true, class: 'form-control', placeholder: t('forms.labels.lname') %>
            <%= f.label :last_name, t('forms.labels.lname') + '*' %>
          </div>
          <%= error_messages(:email) %>
          <div class="form-floating mb-2">
            <%= f.email_field :email, required: true, class: 'form-control', placeholder: t('forms.labels.email') %>
            <%= f.label :email, t('forms.labels.email') + '*' %>
          </div>
          <%= error_messages(:password) %>
          <div class="form-floating mb-2">
            <%= f.password_field :password, required: true, class: 'form-control', placeholder: t('forms.labels.password') %>
            <%= f.label :password, t('forms.labels.password') + '*' %>
          </div>
          <%= error_messages(:password_confirmation) %>
          <div class="form-floating mb-2">
            <%= f.password_field :password_confirmation, required: true, class: 'form-control', placeholder: t('forms.labels.confirm_password') %>
            <%= f.label :password_confirmation, t('forms.labels.confirm_password') + '*' %>
          </div>
          <%= error_messages(:date_of_birth) %>
          <div class="form-floating mb-2">
            <%= f.date_field :date_of_birth, required: true, class: 'form-control', placeholder: t('forms.labels.dob') %>
            <%= f.label :date_of_birth, t('forms.labels.dob') + '*' %>
          </div>
          <%= f.fields_for :company_attributes do |form| %>
            <div class="form-floating mb-2">
              <%= form.text_field :name, required: true, id: "company", class: 'form-control', placeholder: 'Company',
                                  data: { 'subdomain-target': 'source', action: 'input->subdomain#update' } %>
              <%= form.label :name, t('company.label') + '*', for: 'company' %>
            </div>
            <%= error_messages(:"company.subdomain") %>
            <div class="field">
              <%= form.text_field :subdomain, required: true, readonly: true, id: "subdomain", class: 'form-control d-none',
                                  data: { 'subdomain-target': 'field' } %>
            </div>
          <%end%>
          <div class='card mb-2 p-2 bg-light' id='subdomain_area'>
            <p class='mb-0 text-muted'><%= t('forms.labels.portal_message') %></p>
            <p class='mb-0'><%= portal_domain %></p>
          </div>

          <div class="actions">
            <%= f.submit t('forms.buttons.signup'), class: 'btn btn-primary w-100 p-3' %>
          </div>
          <br>
        <% end %>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>

  <div class='col-lg-6 col-md-0 bg-primary d-flex align-items-center justify-content-center'>
    <%= render partial: 'shared/svgs/signup' %>
  </div>
</div>
