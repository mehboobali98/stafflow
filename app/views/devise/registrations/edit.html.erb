<h2><%= I18n.t('headings.edit', user: resource_name.to_s.humanize) %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label I18n.t('forms.labels.email') %><br />
    <%= f.email_field :email, required: true %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <%= f.label I18n.t('forms.labels.password') %> <i>(leave blank if you don't want to change it)</i><br />
    <%= f.password_field :password, required: true %>
    <% if @minimum_password_length %>
      <br />
      <em><%= @minimum_password_length %> characters minimum</em>
    <% end %>
  </div>

  <div class="field">
    <%= f.label I18n.t('forms.labels.confirm_password') %><br />
    <%= f.password_field :password_confirmation, required: true %>
  </div>

  <div class="field">
    <%= f.label I18n.t('forms.labels.current_password') %> <br />
    <%= f.password_field :current_password, required: true %>
  </div>

  <div class="field">
    <%= f.label I18n.t('forms.labels.fname') %> <br />
    <%= f.text_field :first_name, required: true %>
  </div>

  <div class="field">
    <%= f.label I18n.t('forms.labels.lname') %> <br />
    <%= f.text_field :last_name, required: true %>
  </div>

  <div class="field">
    <%= f.label I18n.t('forms.labels.dob') %> <br />
    <%= f.date_field :date_of_birth, required: true %>
  </div>

  <div class="actions">
    <%= f.submit I18n.t('forms.buttons.update') %>
  </div>
<% end %>

<h3> <%= I18n.t('headings.cancel_my_account') %> </h3>



<%= link_to I18n.t('forms.buttons.back'), :back %>
