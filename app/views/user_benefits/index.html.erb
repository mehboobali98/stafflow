<div class="container">
  <h1>User Benefits</h1>
  <%= link_to I18n.t('user_benefit.table.new_user_benefit'), new_user_benefit_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%=I18n.t('user_benefit.table.user_name')%></th>
      <th><%=I18n.t('user_benefit.table.benefit_name')%></th>
      <th><%=I18n.t('user_benefit.table.amount')%></th>
      <th><%=I18n.t('user_benefit.table.status')%></th>
      <th style="text-align:left" colspan="2">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @user_benefit.each do |user_benefit| %>
      <tr>  
        <td><%=user_benefit.user.first_name%>
        <%' '%>
        <%=user_benefit.user.last_name%></td>
        <td><%= user_benefit.benefit.name %></td>
        <td><%= user_benefit.amount %></td>
        <td><%= user_benefit.status ? I18n.t('user_benefit.table.active') : I18n.t('user_benefit.table.inactive') %></td>
        <td><%= link_to I18n.t('form.button.update'), user_benefit_path(user_benefit), class: 'btn btn-secondary' %></td>
        <td><%= link_to I18n.t('form.button.delete'), user_benefit, method: :delete, data: { confirm: I18n.t('form.message.confirmation') }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div> 
