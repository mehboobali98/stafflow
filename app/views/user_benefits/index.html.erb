<div class="container">
  <h1><%= t('user_benefit.headings.user_benefits') %></h1>
  <%= link_to t('user_benefit.table.new_user_benefit'), new_member_user_benefit_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('user_benefit.table.user_name') %></th>
      <th><%= t('user_benefit.table.benefit_name') %></th>
      <th><%= t('user_benefit.table.amount') %></th>
      <th><%= t('user_benefit.table.status') %></th>
      <th colspan="2"><%= t('user_benefit.table.options') %></th>
    </tr>
  </thead>
  <tbody>
    <% @user_benefits.each do |user_benefit| %>
      <tr>  
        <td><%= user_benefit.user.full_name%></td>
        <td><%= user_benefit.benefit.name %></td>
        <td><%= user_benefit.amount %></td>
        <td><%= user_benefit.status ? t('user_benefit.table.active') : t('user_benefit.table.inactive') %></td>
        <td><%= link_to t('form.button.update'), member_user_benefit_path(@user, user_benefit), class: 'btn btn-secondary' %></td>
        <td><%= link_to t('form.button.delete'), member_user_benefit_path(@user, user_benefit), method: :delete, data: { confirm: t('form.message.confirmation') }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div> 
