<div class="container">
  <h1>User Benefits</h1>
  <%= link_to "New User Benefit", new_user_benefit_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>User Email</th>
      <th>Name</th>
      <th>Amount</th>
      <th>Status</th>
      <th style="text-align:left" colspan="2">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @user_benefit.each do |user_benefit| %>
      <tr>
        <td><%=User.find(user_benefit.user_id).email%></td>
        <td><%= user_benefit.benefit.name %></td>
        <td><%= user_benefit.amount %></td>
        <td><%= user_benefit.status ? 'active' : 'inactive' %></td>
        <td><%= link_to "update", user_benefit_path(user_benefit), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", user_benefit, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div> 
