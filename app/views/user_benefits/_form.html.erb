<%= form_for @user_benefit do |user_benefit| %>
  <div class = "row">
    <div class = "col-md-4">
      <div class="mb-3 ">
        <%= user_benefit.label :Benefit_Amount, { class: "form-label m-3"} %>
        <%= user_benefit.text_field :amount, { class: "form-control m-3", required: "required", placeholder: "Benefit Amount" } %>
      </div>
        <div class="mb-3 ">
          <%= user_benefit.label :Benefit_Status, { class: "form-label m-3"} %>
        <div class="form-check form-check-inline ml-3">
          <%= label :status, "Active", value: false %>
          <%= user_benefit.radio_button :status, true, checked: true, value: true %>
        </div>
        <div class="form-check form-check-inline">
          <%= label :status, "Inactive", value: false %>
          <%= user_benefit.radio_button :status, false, checked: true, value: false %>
        </div>
      </div>
      <%= user_benefit.submit "Submit", class: "btn btn-primary m-3" %>
    </div>
  </div>
<% end %>