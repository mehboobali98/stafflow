<%= javascript_pack_tag 'users_benefit_new', 'data-turbolinks-track': 'reload' %>

<%= form_with model: [@user, @users_benefits], url: member_users_benefits_path do |users_benefit| %>
  <div class="container">
    <div class="row">
      <div>
        <table class="table table-bordered table-striped">
          <thead class="table-dark">
            <tr>
              <th><%= t('users_benefit.table.select') %></th>
              <th><%= t('users_benefit.table.benefit_name') %></th>
              <th><%= t('users_benefit.table.amount') %></th>
            </tr>
          </thead>
          <tbody>
            <% @benefits.each_with_index do |benefit, index| %>
              <% check = true %>
              <% @users_benefits.each do |users_benefit| %>
                <% check = false if users_benefit.benefit.name == benefit.name %>
              <% end %>
              <% if check %>
                <tr>
                  <td>
                    <div class="custom-control custom-checkbox">
                      <%= check_box_tag "users_benefit[sequence_num][]", benefit.sequence_num, false, data: { "id": "number_field_#{index}" } %>
                    </div>
                  </td>
                  <td><%= benefit.name %></td>
                  <td>
                    <div class="form-group">
                      <%= number_field_tag "number_field_#{index}" , nil , disabled: true %>
                    </div>
                  </td>
                </tr>
              <% end %>  
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%= submit_tag t('form.button.submit'), class: "btn btn-primary m-1" %>
  </div>
<% end %>