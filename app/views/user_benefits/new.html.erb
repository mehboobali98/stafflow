<%= javascript_pack_tag 'user_benefit_new', 'data-turbolinks-track': 'reload' %>

<%= form_tag user_benefits_path do |user_benefit| %>
  <div class="container">
    <div class="row">
      <div>
        <table class="table table-bordered table-striped">
          <thead class="table-dark">
            <tr>
              <th><%= t('user_benefit.table.select') %></th>
              <th><%= t('user_benefit.table.benefit_name') %></th>
              <th><%= t('user_benefit.table.amount') %></th>
            </tr>
          </thead>
          <tbody>
            <% @benefits.each do |benefit| %>
              <% check = true %>
              <% @user_benefits.each do |user_benefit| %>
                <% check = false if user_benefit.benefit.name == benefit.name %>
              <% end %>
              <% if check %>
                <tr>
                  <td>
                    <div class="custom-control custom-checkbox">
                      <%= check_box_tag 'user_benefit[benefit_id][]', benefit.id %>
                    </div>
                  </td>
                  <td><%= benefit.name %></td>
                  <td>
                    <div class="form-group">
                    <%= number_field_tag 'user_benefit[amount][]', nil, disabled: true, required: true %>
                    </div>
                  </td>
                </tr>
              <% end %>  
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%= submit_tag t('form.button.submit'), class: "btn btn-primary m-1" %>
  </div>
<% end %>