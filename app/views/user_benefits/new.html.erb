<%= form_tag user_benefits_path do |user_benefit| %>
  <div class="container">
    <div class="row">
      <div>
        <table class="table table-bordered table-striped">
          <thead class="table-dark">
            <tr>
              <th scope="col"><%= t('user_benefit.table.select') %></th>
              <th scope="col"><%= t('user_benefit.table.benefit_name') %></th>
              <th scope="col"><%= t('user_benefit.table.amount') %></th>
              <th scope="col"><%= t('user_benefit.table.status') %></th>
            </tr>
          </thead>
          <tbody>
            <% @benefits.each do |benefit| %>
              <tr>
                <td>
                  <div class="custom-control custom-checkbox">
                    <%= check_box_tag 'user_benefit[benefit_id][]', benefit.id %>
                  </div>
                </td>
                <td><%= benefit.name %></td>
                <td>
                  <div class="form-group">
                  <%= number_field_tag 'user_benefit[amount][]', required: true %>
                  </div>
                </td>
                <td>
                  <%= check_box_tag 'user_benefit[status][]' %>
                </td>
              </tr>  
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%= submit_tag t('form.button.submit'), class: "btn btn-primary m-1" %>
  </div>
<% end %>