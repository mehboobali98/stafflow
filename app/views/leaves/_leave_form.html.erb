<div class="container">
  <div class="row justify-content-center">
    <div class="col-4">
      <h1> <%= heading%></h1>
      <% if leave.errors.any? %>
        <div>
          <ul>
            <% leave.errors.full_messages.each do |message| %>
              <li class='text-danger'><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= form_with model: leave, local:true, :html => {'class' => 'card p-3 bg-light'} do |form| %>
        <div class="form-group mb-3">
          <%= form.label :name, 'leave name ' %>
          <%= form.text_field :name, required: true, class: 'form-control', placeholder: "Enter leave name"%>
        </div>
        <div class="form-group mb-3">
          <%= form.label :count, 'leave count' %>
          <%= form.number_field :count, in: 1..20, required: true, class: 'form-control', placeholder: "Enter leave count"%>
        </div>
        <div>
          <%= form.submit class: 'card-link btn btn-primary'%>
        </div>
      <% end %>
    </div>
  </div>
</div>