<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_with model: leave, local: true do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :name, label: t('leave.forms.labels.name'),
                                      required: true,
                                      placeholder: t('leave.forms.placeholders.name'))) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :default_count, as: :number_field,
                                      label: t('leave.forms.labels.count'), required: true,
                                      in: MIN_LEAVE_COUNT..MAX_LEAVE_COUNT, step: LEAVE_COUNT_SCALE,
                                      placeholder: t('leave.forms.placeholders.count'))) %>
    <%= render(ButtonComponent.new(type: 'submit')) { t('form.button.submit') } %>
  <% end %>
<% end %>
