<div class="container">
  <div class="row justify-content-center">
    <div class="col-4">
      <h1><%= local_assigns&.dig(:heading) %></h1>
      <%= form_with model: leave, local:true, html: { class: 'card p-3 bg-light' } do |form| %>
        <div class="form-group mb-3">
          <%= form.label :name, t('leave.forms.labels.name') %>
          <%= form.text_field :name, required: true, class: 'form-control', placeholder: t('leave.forms.placeholders.name') %>
        </div>
        <div class="form-group mb-3">
          <%= form.label :count, t('leave.forms.labels.count') %>
          <%= form.number_field :count, in: 1..20, required: true, class: 'form-control', placeholder: t('leave.forms.placeholders.count') %>
        </div>
        <div>
          <%= form.submit class: 'card-link btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>