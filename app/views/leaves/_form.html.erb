<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1><%= local_assigns[:heading] %></h1>
      <%= form_with model: leave, local: true, html: { class: 'card p-3 bg-light' } do |form| %>
        <div class="form-group mb-3">
          <%= form.label :name, t('leave.forms.labels.name'), class: 'text-grey-darkest' %>
          <%= form.text_field :name, required: true, class: 'form-control', placeholder: t('leave.forms.placeholders.name') %>
        </div>
        <div class="form-group mb-3">
          <%= form.label :default_count, t('leave.forms.labels.count'), class: 'text-grey-darkest' %>
          <%= form.number_field :default_count, in: VALID_LEAVE_RANGE, required: true, class: 'form-control', step: LEAVE_COUNT_SCALE, placeholder: t('leave.forms.placeholders.count') %>
        </div>
        <div class="form-group mb-3">
          <%= form.submit class: 'card-link btn btn-primary' if can?(%i[create edit], leave) %>
        </div>
      <% end %>
    </div>
  </div>
</div>