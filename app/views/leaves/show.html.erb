<div class="contrainer">
  <div class="row justify-content-center">
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-header">
          Featured Leave
        </div>
        <div class="card-body">
          <h1 class="card-title"><%= @leave.name %></h1>
          <p class="card-text"><%= @leave.count %></p>
        </div>
        <div class="card-footer">
          <%= link_to "Edit", edit_leave_path(@leave), class: 'btn btn-secondary'%>
          <%= link_to "Destroy", leave_path(@leave), class: 'btn btn-danger',
                  method: :delete,
                  data: { confirm: "Are you sure?" } %>
          <%= link_to "View all leave types", leaves_path, class: 'btn btn-outline-primary' %>
        </div>
      </div>
    </div>
  </div>
</div>