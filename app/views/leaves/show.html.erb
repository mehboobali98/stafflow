<% content_for :title, @leave.name %>
<%= render(PageHeaderComponent.new(title: t('leave.headings.featured_leave'))) %>

<%= render(CardComponent.new(class: 'form-card')) do |card| %>
  <h2 class="h4 mb-1"><%= @leave.name %></h2>
  <p class="text-secondary mb-0"><%= @leave.default_count %></p>
  <% card.with_footer do %>
    <% if can?(:show, @leave) %>
      <%= render(ButtonComponent.new(variant: :secondary, href: edit_leave_path(@leave))) do %>
        <%= t('leave.forms.links.edit') %>
      <% end %>
    <% end %>
    <% if can?(:destroy, @leave) %>
      <%= render(ButtonComponent.new(variant: :danger, href: leave_path(@leave), method: :delete,
                                     class: 'ms-2',
                                     data: { turbo_confirm: t('leave.messages.delete_confirm') })) do %>
        <%= t('leave.forms.links.delete') %>
      <% end %>
    <% end %>
    <% if can?(:index, Leave) %>
      <%= render(ButtonComponent.new(variant: :ghost, href: leaves_path, class: 'ms-2')) do %>
        <%= t('common.back') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
