<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card text-center">
        <div class="card-header">
          <%= t('leave.headings.featured_leave') %>
        </div>
        <div class="card-body">
          <h1 class="card-title"><%= @leave.name %></h1>
          <p class="card-text"><%= @leave.default_count %></p>
        </div>
        <div class="card-footer">
          <%= link_to t('leave.forms.links.edit'), edit_leave_path(@leave), class: 'btn btn-secondary' if can?(:show, @leave) %>
          <%= link_to t('leave.forms.links.delete'), leave_path(@leave), class: 'btn btn-danger', method: :delete, data: { confirm: t('leave.messages.delete_confirm') } if can?(:destroy, @leave) %>
          <%= link_to t('common.back'), :back, class: 'btn btn-outline-primary' if can?(:index, Leave) %>
        </div>
      </div>
    </div>
  </div>
</div>