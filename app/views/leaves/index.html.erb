<div class='pms-heading ms-1'>  
  <div class='row'>
    <div class='col-10'>
      <h2><%= t('leave.headings.leave') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('leave.forms.links.create'), new_leave_path, class: 'btn btn-primary mt-1' %>
    </div>
  </div>
  <%= link_to 'My Applied Leaves', member_applied_leaves_path(current_user), class: 'card-link' unless current_user.account_owner? %>
  <%= link_to 'My Available Leaves', member_user_leaves_path(current_user), class: 'card-link' unless current_user.account_owner? %>
  <%= link_to 'All Applied Leaves', all_applied_leaves_path, class: 'card-link' if current_user.hr? || current_user.account_owner? %>
</div>
<br><br>
<div>
  <table class="table table-hover">
    <thead class="pms-table-header p-3 table-borderless">
      <tr>
        <th><%= t('leave.headings.name') %></th>
        <th><%= t('leave.headings.count_allowed') %></th>
        <th><%= t('leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody>
      <% @leaves.each do |leave| %>
        <tr>
          <td><%= leave.name %></td>
          <td><%= leave.default_count %></td>
          <td>
            <% if can?(:show, leave) %>
              <%= link_to leave do %>
                <i class='fa fa-eye fa-lg'></i>
              <% end %>
            <% end %>
            <% if can?(:edit, leave) %>
              <%= link_to edit_leave_path(leave) do %>
                <i class='fa fa-bars ms-3'></i>
              <% end %>
            <% end %>
            <% if can?(:destroy, leave) %>
              <%= link_to leave, method: :delete, data: { confirm: t('leave.messages.delete_confirm') } do %>
                <i class='fa fa-trash ms-3'></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>