<div class='card-header mb-3'>
  <h1><%= t('leave.headings.leave') %></h1>
  <%= link_to 'My Applied Leaves', member_applied_leaves_path(current_user), class: 'card-link' unless current_user.account_owner? %>
  <%= link_to 'My Available Leaves', member_user_leaves_path(current_user), class: 'card-link' unless current_user.account_owner? %>
  <%= link_to 'All Applied Leaves', all_applied_leaves_path, class: 'card-link' if current_user.hr? || current_user.account_owner? %>
</div>
<div class="container">
  <%= link_to t('leave.forms.links.create'), new_leave_path, class: 'btn btn-outline-primary mb-2' %>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th><%= t('leave.headings.name') %></th>
        <th><%= t('leave.headings.count_allowed') %></th>
        <th class="text-center" colspan="3"><%= t('leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody>
      <% @leaves.each do |leave| %>
        <tr>
          <td><%= leave.name %></td>
          <td><%= leave.default_count %></td>
          <td><%= link_to t('leave.forms.links.show'), leave, class: 'btn btn-info' if can?(:show, leave) %></td>
          <td><%= link_to t('leave.forms.links.edit'), edit_leave_path(leave), class: 'btn btn-secondary' if can?(:edit, leave) %></td>
          <td><%= link_to t('leave.forms.links.delete'), leave, method: :delete, data: { confirm: t('leave.messages.delete_confirm') }, class: 'btn btn-danger' if can?(:destroy, leave) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>