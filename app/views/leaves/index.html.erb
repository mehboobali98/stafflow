<% content_for :title, t('leave.headings.leave') %>
<%= render(PageHeaderComponent.new(title: t('leave.headings.leave'))) do |header| %>
  <% if can?(:create, Leave) %>
    <% header.with_actions do %>
      <%= render(ButtonComponent.new(href: new_leave_path)) do %>
        <%= t('leave.forms.links.create') %>
      <% end %>
    <% end %>
  <% end %>
  <% unless current_user.account_owner? %>
    <% header.with_link { link_to t('user_leave.myappleaves'), member_applied_leaves_path(current_user) } %>
    <% header.with_link { link_to t('user_leave.myavleaves'), member_user_leaves_path(current_user) } %>
  <% end %>
  <% if current_user.hr? || current_user.account_owner? %>
    <% header.with_link { link_to t('applied_leave.all'), all_applied_leaves_path } %>
    <% header.with_link { link_to t('applied_leave.add_user'), new_applied_leave_by_hr_applied_leaves_path } %>
  <% end %>
<% end %>

<%= turbo_frame_tag 'leaves_table', data: { turbo_action: 'advance' } do %>
  <%= render(TableComponent.new(class: 'table-hover')) do |table| %>
    <% table.with_head do %>
      <tr>
        <th><%= t('leave.headings.name') %></th>
        <th><%= t('leave.headings.count_allowed') %></th>
        <th class="text-end"><%= t('leave.headings.options') %></th>
      </tr>
    <% end %>
    <% table.with_body do %>
      <% @leaves.each do |leave| %>
        <tr>
          <td><%= leave.name %></td>
          <td><%= leave.default_count %></td>
          <td class="text-end text-nowrap">
            <% if can?(:show, leave) %>
              <%= link_to leave, 'aria-label': t('leave.links.view') do %>
                <i class='fa fa-eye fa-lg'></i>
              <% end %>
            <% end %>
            <% if can?(:edit, leave) %>
              <%= link_to edit_leave_path(leave), class: 'ms-3', 'aria-label': t('leave.links.edit') do %>
                <i class='fa fa-bars'></i>
              <% end %>
            <% end %>
            <% if can?(:destroy, leave) %>
              <%= link_to leave, class: 'ms-3', 'aria-label': t('leave.links.delete'),
                                 data: { turbo_method: :delete,
                                         turbo_confirm: t('leave.messages.delete_confirm') } do %>
                <i class='fa fa-trash'></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
  <% if @leaves.empty? %>
    <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
  <% end %>
  <%= render partial: 'shared/pagination', locals: { resource: @leaves } %>
<% end %>
