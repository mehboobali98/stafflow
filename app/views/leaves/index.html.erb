<div class='card-header m-4'>
  <%= link_to t('dashboard.my_applied_leaves'), member_applied_leaves_path(current_user), class: 'card-link' if can?(:read, AppliedLeave) %>
  <%= link_to t('my_available_leaves'), member_user_leaves_path(current_user), class: 'card-link' if can?(:read, UserLeave) %>
  <%= link_to t('all_applied_leaves'), all_applied_leaves_path, class: 'card-link' if can?(:all_applied_leaves, AppliedLeave) %>
</div>
<div class="container">
  <%= link_to t('leave.forms.links.create'), new_leave_path, class: 'btn btn-outline-primary mb-2' %>
  <div id="leaves_table">
    <%= render partial: 'leaves_list', locals: { leaves: @leaves } %>
  </div>
</div>