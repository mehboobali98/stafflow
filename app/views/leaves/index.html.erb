<%= render partial: 'shared/leave_navbar' %>
<div class="container">
  <h1><%= t('leave.headings.leave') %></h1>
  <%= link_to t('leave.forms.links.create'), new_leave_path, class: 'btn btn-outline-dark mb-2' %>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th><%= t('leave.headings.name') %></th>
        <th><%= t('leave.headings.count_allowed') %></th>
        <th class="text-center" colspan="3"><%= t('leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody>
      <% @leaves.each do |leave| %>
        <tr>
          <td><%= leave.name %></td>
          <td><%= leave.default_count %></td>
          <td><%= link_to t('leave.forms.links.show'), leave, class: 'btn btn-info' %></td>
          <td><%= link_to t('leave.forms.links.edit'), edit_leave_path(leave), class: 'btn btn-secondary' %></td>
          <td><%= link_to t('leave.forms.links.delete'), leave, method: :delete, data: { confirm: t('leave.messages.delete_confirm') }, class: 'btn btn-danger' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>