<div class="container">
  <h1>Leave</h1>
  <%= link_to "New Leave", new_leave_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>Name</th>
      <th>Count Allowed</th>
      <th style="text-align:center" colspan="3">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @leaves.each do |leave| %>
      <tr>
        <td><%= leave.name %></td>
        <td><%= leave.count %></td>
        <td><%= link_to "Show", leave, class: 
        'btn btn-info' %></td>
        <td><%= link_to "Edit", edit_leave_path(leave), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", leave, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>