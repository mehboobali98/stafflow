<div class="container">
  <h1><%= t('leave.headings.leave') %></h1>
  <div class="d-flex justify-content-between mb-2">
    <%= link_to t('leave.forms.links.create'), new_leave_path, class: 'btn btn-outline-primary' if can?(:create, Leave) %>
    <%= link_to t('user.apply_for_leave'), new_member_applied_leave_path(current_user), class: 'btn btn-outline-secondary' if can?(:create, AppliedLeave) %>
    <%= link_to 'View Leave Applications', all_applied_leaves_path, class: 'btn btn-outline-info' if can?(:all_applied_leaves, AppliedLeave) %>
  </div>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th><%= t('leave.headings.name') %></th>
        <th><%= t('leave.headings.count_allowed') %></th>
        <th class="text-center" colspan="3"><%= t('leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody>
      <% @leaves.each do |leave| %>
        <tr>
          <td><%= leave.name %></td>
          <td><%= leave.default_count %></td>
          <td><%= link_to t('leave.forms.links.show'), leave, class: 'btn btn-info' if can?(:show, leave) %></td>
          <td><%= link_to t('leave.forms.links.edit'), edit_leave_path(leave), class: 'btn btn-secondary' if can?(:edit, leave) %></td>
          <td><%= link_to t('leave.forms.links.delete'), leave, method: :delete, data: { confirm: t('leave.messages.delete_confirm') }, class: 'btn btn-danger' if can?(:destroy, leave) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class='pagination-wrapper'>
  <%= will_paginate @leaves, container: false %>
</div>