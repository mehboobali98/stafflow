<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_with **applied_leave_form_values(user, applied_leave) do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :user_leave_id,
                                      label: t('applied_leave.labels.available_leaves'))) do %>
      <%= collection_select(:applied_leave, :user_leave_id, available_user_leaves, :id, :name, {},
                            { class: 'form-select' }) %>
    <% end %>
    <%= render(FormFieldComponent.new(form: form, attribute: :leave_duration_type, as: :select,
                                      label: t('applied_leave.labels.leave_duration'))) do %>
      <%= form.select :leave_duration_type, options_for_select(leave_duration_type), {},
                      { class: 'form-select' } %>
    <% end %>
    <%= render(FormFieldComponent.new(form: form, attribute: :applied_from, as: :date_field,
                                      label: t('applied_leave.labels.leave_from'), required: true)) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :applied_till, as: :date_field,
                                      label: t('applied_leave.labels.leave_to'), required: true)) %>
    <%= render(ButtonComponent.new(type: 'submit')) { t('applied_leave.links.submit') } %>
  <% end %>
<% end %>
