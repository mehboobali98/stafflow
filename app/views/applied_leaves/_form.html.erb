<div class="container py-4">
  <h1><%= t('applied_leave.headings.new_leave_application') %></h1>
  <%= form_with scope: :applied_leave, url: determine_form_url(user, applied_leave), method: determine_form_method(applied_leave), local: true do |form| %>
    <div class="form mb-4">
      <%= form.label :user_leave_id, t('applied_leave.labels.available_leaves'), class: "form-label" %>
      <%= collection_select(:applied_leave, :user_leave_id, available_user_leaves, :id, :name, {}, { class: "form-control" }) %>
    </div>
    <div class="form mb-4">
      <%= form.label :leave_duration_id, t('applied_leave.labels.leave_duration') %>
      <%= form.select :leave_duration_id, options_for_select(AppliedLeave::LEAVE_DURATION.transform_keys{ |key| key.to_s.humanize }), {}, class: "form-control" %>
    </div>
    <div class="form mb-4">
      <%= form.label :applied_from, t('applied_leave.labels.leave_from'), class: "form-label" %>
      <%= form.date_field :applied_from, required: true, class: "form-control" %>
    </div>
    <div class="form mb-4">
      <%= form.label :applied_till, t('applied_leave.labels.leave_to'), class: "form-label" %>
      <%= form.date_field :applied_till, required: true, class: "form-control" %>
    </div>
    <div class="form mb-4">
      <%= form.submit t('applied_leave.links.submit'), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>