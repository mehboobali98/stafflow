<% applied_leaves.each do |applied_leave| %>
  <tr>
    <td><%= check_box_tag "applied_leave_ids[]", applied_leave.id, false, disabled: !(applied_leave.pending?) %></td>
    <td><%= applied_leave.user.email %></td>
    <td><%= applied_leave.leave.name %></td>
    <td><%= applied_leave.leave_duration_name_from_id.to_s.humanize %></td>
    <td><%= applied_leave.applied_at %></td>
    <td><%= applied_leave.applied_till %></td>
    <td><%= applied_leave.state.humanize %></td>
    <td><%= link_to t('applied_leave.links.approve'), approve_applied_leave_path(applied_leave), method: :patch, class: 'btn btn-success' %></td>
    <td><%= link_to t('applied_leave.links.reject'), reject_applied_leave_path(applied_leave), method: :patch, class: 'btn btn-danger' %></td>
  </tr>
<% end %>