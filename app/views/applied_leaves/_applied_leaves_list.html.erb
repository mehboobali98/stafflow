<% applied_leaves.each do |applied_leave| %>
  <tr>
    <td><%= applied_leave.user_leave.leave.name %></td>
    <td><%= applied_leave.applied_at %></td>
    <td><%= applied_leave.applied_till %></td>
    <td><%= applied_leave.state %></td>
    <td><%= link_to t('applied_leave.links.edit'), edit_applied_leave_path(applied_leave), class: 'btn btn-secondary' if applied_leave.pending? %></td>
    <td><%= link_to t('applied_leave.links.delete'), applied_leave, method: :delete, data: { confirm: t('applied_leave.messages.delete_confirm') }, class: 'btn btn-danger' %></td>
  </tr>
<% end %>