<!-- for approving/rejecting leaves-->
<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th></th>
      <th><%= t('applied_leave.headings.applicant_email') %></th>
      <th><%= t('applied_leave.headings.leave_type') %></th>
      <th><%= t('applied_leave.headings.leave_duration') %></th>
      <th><%= t('applied_leave.headings.leave_from') %></th>
      <th><%= t('applied_leave.headings.leave_to') %></th>
      <th><%= t('applied_leave.headings.leave_status') %></th>
      <th class="text-center" colspan="2"><%= t('applied_leave.headings.options') %></th>
    </tr>
  </thead>
  <tbody>
    <% applied_leaves.each do |applied_leave| %>
      <tr>
        <td><%= check_box_tag "applied_leave_ids[]", applied_leave.id, false, class: 'js-selected-applied-leave', disabled: !(applied_leave.pending?) %></td>
        <td><%= applied_leave.user.email %></td>
        <td><%= applied_leave.leave.name %></td>
        <td><%= t("applied_leave.links.#{applied_leave.leave_duration_name}") %></td>
        <td><%= applied_leave.applied_from %></td>
        <td><%= applied_leave.applied_till %></td>
        <td><%= t("applied_leave.links.#{applied_leave.state}") %></td>
        <td><%= link_to t('applied_leave.links.approve'), approve_applied_leave_path(applied_leave), method: :patch, class: 'btn btn-success' if can?(:approve_leave, applied_leave) %></td>
        <td><%= link_to t('applied_leave.links.reject'), reject_applied_leave_path(applied_leave), method: :patch, class: 'btn btn-danger' if can?(:reject_leave, applied_leave) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<div class='js-applied-leaves-pagination pagination-wrapper'>
  <%= will_paginate @applied_leaves, container: false %>
</div>