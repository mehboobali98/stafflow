<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th></th>
      <th><%= t('applied_leave.headings.applicant_email') %></th>
      <th><%= t('applied_leave.headings.leave_type') %></th>
      <th><%= t('applied_leave.headings.leave_duration') %></th>
      <th><%= t('applied_leave.headings.leave_from') %></th>
      <th><%= t('applied_leave.headings.leave_to') %></th>
      <th><%= t('applied_leave.headings.leave_status') %></th>
      <th class="text-end"><%= t('applied_leave.headings.options') %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% applied_leaves.each do |applied_leave| %>
      <tr>
        <td><%= check_box_tag "applied_leave_ids[]", applied_leave.id, false,
                              id: "applied_leave_#{applied_leave.id}",
                              class: 'js-selected-applied-leave',
                              disabled: !applied_leave.pending?,
                              data: { 'checkbox-group-target': 'item',
                                      action: 'change->checkbox-group#refresh' } %></td>
        <td><%= applied_leave.user.email %></td>
        <td><%= applied_leave.leave.name %></td>
        <td><%= t("applied_leave.labels.#{applied_leave.leave_duration_name}") %></td>
        <td><%= applied_leave.applied_from %></td>
        <td><%= applied_leave.applied_till %></td>
        <td>
          <%= render(BadgeComponent.new(variant: applied_leave.state)) do %>
            <%= t("applied_leave.labels.#{applied_leave.state}") %>
          <% end %>
        </td>
        <td class="text-end text-nowrap">
          <% if can?(:approve_leave, applied_leave) %>
            <%= render(ButtonComponent.new(variant: :success, size: :sm, method: :patch,
                                           href: approve_applied_leave_path(applied_leave))) do %>
              <%= t('applied_leave.links.approve') %>
            <% end %>
          <% end %>
          <% if can?(:reject_leave, applied_leave) %>
            <%= render(ButtonComponent.new(variant: :danger, size: :sm, method: :patch,
                                           href: reject_applied_leave_path(applied_leave))) do %>
              <%= t('applied_leave.links.reject') %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<div class='pagination-wrapper'>
  <%= will_paginate applied_leaves, container: false %>
</div>
