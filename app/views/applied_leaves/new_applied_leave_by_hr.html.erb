<% content_for :title, t('applied_leave.headings.add_user_leave') %>
<div class="container py-4">
  <h1><%= t('applied_leave.headings.add_user_leave') %></h1>
  <%= form_with scope: :applied_leave, url: :create_applied_leave_by_hr_applied_leaves, method: :post,
                data: { controller: 'dependent-select',
                        dependent_select_url_value: get_available_user_leaves_applied_leaves_path(member_id: 'VALUE'),
                        action: 'combobox:select->dependent-select#load' } do |form| %>
    <%= render(FormFieldComponent.new(form: form, attribute: :member_id,
                                      label: t('applied_leave.messages.select_employees'),
                                      id: 'applied_leave_member_id_search')) do %>
      <%= render(ComboboxComponent.new(form: form, attribute: :member_id,
                                       url: search_users_applied_leaves_path,
                                       id: 'applied_leave_member_id_search',
                                       label_attribute: 'email',
                                       placeholder: t('applied_leave.messages.search_employees'))) %>
    <% end %>

    <%= render(FormFieldComponent.new(form: form, attribute: :user_leave_id,
                                      label: t('applied_leave.messages.select_leave_type'),
                                      id: 'leaves_select')) do %>
      <%= form.select :user_leave_id, {}, { prompt: t('applied_leave.messages.select_leave_type') },
                      class: 'form-select', id: 'leaves_select',
                      data: { dependent_select_target: 'select' } %>
    <% end %>

    <%= render(FormFieldComponent.new(form: form, attribute: :leave_duration_type,
                                      label: t('applied_leave.labels.leave_duration'))) do %>
      <%= form.select :leave_duration_type, options_for_select(leave_duration_type), {},
                      class: 'form-select' %>
    <% end %>

    <%= render(FormFieldComponent.new(form: form, attribute: :applied_from, as: :date_field,
                                      label: t('applied_leave.labels.leave_from'), required: true)) %>

    <%= render(FormFieldComponent.new(form: form, attribute: :applied_till, as: :date_field,
                                      label: t('applied_leave.labels.leave_to'), required: true)) %>

    <%= form.submit t('applied_leave.links.submit'), class: 'btn btn-primary' %>
  <% end %>
</div>
