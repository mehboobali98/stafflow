<%= render partial: 'shared/leaves_header', locals: { heading: t('applied_leave.headings.applied_leaves') } %>
<div class="container">
  <%= link_to t('applied_leave.links.apply_for_leave'), new_member_applied_leave_path(@user), class: 'btn btn-outline-primary mb-2' if can?(:create, AppliedLeave) %>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th><%= t('applied_leave.headings.leave_type') %></th>
        <th><%= t('applied_leave.headings.leave_from') %></th>
        <th><%= t('applied_leave.headings.leave_to') %></th>
        <th><%= t('applied_leave.headings.leave_status') %></th>
        <th class="text-center" colspan="2"><%= t('applied_leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody id="applied_leave_table_body">
      <%= render partial: 'applied_leaves_index', locals: { applied_leaves: @applied_leaves } %>
    </tbody>
  </table>
</div>
<div class='pagination-wrapper'>
  <%= will_paginate @applied_leaves, container: false %>
</div>