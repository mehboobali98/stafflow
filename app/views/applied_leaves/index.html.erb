<% content_for :title, t('applied_leave.headings.applied_leaves') %>
<%= render(PageHeaderComponent.new(title: t('applied_leave.headings.applied_leaves'))) do |header| %>
  <% if can?(:create, AppliedLeave) %>
    <% header.with_actions do %>
      <%= render(ButtonComponent.new(href: new_member_applied_leave_path(@user))) do %>
        <%= t('applied_leave.links.apply_for_leave') %>
      <% end %>
    <% end %>
  <% end %>
  <% header.with_link { link_to t('leave.all'), leaves_path } %>
  <% unless current_user.account_owner? %>
    <% header.with_link { link_to t('user_leave.myappleaves'), member_applied_leaves_path(current_user) } %>
    <% header.with_link { link_to t('user_leave.myavleaves'), member_user_leaves_path(current_user) } %>
  <% end %>
<% end %>

<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('applied_leave.headings.leave_type') %></th>
      <th><%= t('applied_leave.headings.leave_from') %></th>
      <th><%= t('applied_leave.headings.leave_to') %></th>
      <th><%= t('applied_leave.headings.leave_status') %></th>
      <th class="text-end"><%= t('applied_leave.headings.options') %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <%= render partial: 'applied_leaves_index', locals: { applied_leaves: @applied_leaves } %>
  <% end %>
<% end %>
<% if @applied_leaves.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
<div class='pagination-wrapper'>
  <%= will_paginate @applied_leaves, container: false %>
</div>
