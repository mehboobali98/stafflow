<div class="container">
  <h1>Applied Leaves</h1>
  <%= link_to "Apply for leave", new_applied_leave_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th> Leave type </th>
      <th> Leave from </th>
      <th> Leave to </th>
      <th class="text-center" colspan="3">Options</th>
    </tr>
  </thead>
  <tbody id="applied_leave_table_body">
    <% binding.pry %>
    <%= render partial: 'applied_leaves_list', locals: { applied_leaves: @applied_leaves} %>
  </tbody>
</table>
</div>