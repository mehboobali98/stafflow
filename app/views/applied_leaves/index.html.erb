<div class='pms-heading p-3'>
  <div class='row'>
    <div class='col-10'>
      <h2 class="mb-3"><%= t('applied_leave.headings.applied_leaves') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('applied_leave.links.apply_for_leave'), new_member_applied_leave_path(@user), class: 'btn btn-primary mb-2' if can?(:create, AppliedLeave) %>
    </div>
  </div>
  <%= link_to t('leave.all'), leaves_path, class: 'card-link' %>  
  <% unless current_user.account_owner? %>
      <%= link_to t('user_leave.myappleaves'), member_applied_leaves_path(current_user), class: 'card-link' %>
      <%= link_to t('user_leave.myavleaves'), member_user_leaves_path(current_user), class: 'card-link' %> 
  <% end %>
</div>

<br>
<br>
<div class='p-3'>
  <table class="table table-hover">
    <thead class="pms-table-header">
    <tr>
        <th><%= t('applied_leave.headings.leave_type') %></th>
        <th><%= t('applied_leave.headings.leave_from') %></th>
        <th><%= t('applied_leave.headings.leave_to') %></th>
        <th><%= t('applied_leave.headings.leave_status') %></th>
        <th><%= t('applied_leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody id="applied_leave_table_body">
      <%= render partial: 'applied_leaves_index', locals: { applied_leaves: @applied_leaves } %>
    </tbody>
  </table>
  <% if @applied_leaves.empty? %>
    <div class="d-flex justify-content-md-center align-items-center mt-5">
      <h1 class='text-muted'><%= t('nodata') %></h1>
    </div>
  <% end %>
</div>
<div class='pagination-wrapper'>
  <%= will_paginate @applied_leaves, container: false %>
</div>