<% applied_leaves.each do |applied_leave| %>
  <tr>
    <td><%= applied_leave.leave.name %></td>
    <td><%= applied_leave.applied_from %></td>
    <td><%= applied_leave.applied_till %></td>
    <td><%= t("applied_leave.links.#{applied_leave.state}") %></td>
    <td><%= link_to t('applied_leave.links.edit'), edit_member_applied_leave_path(@user, applied_leave), class: 'btn btn-secondary' if applied_leave.pending? && can?(:edit, applied_leave) %></td>
    <td><%= link_to t('applied_leave.links.delete'), member_applied_leave_path(@user, applied_leave), method: :delete, data: { confirm: t('applied_leave.messages.delete_confirm') }, class: 'btn btn-danger' if applied_leave.pending? && can?(:delete, applied_leave) %></td>
  </tr>
<% end %>