<% applied_leaves.each do |applied_leave| %>
  <tr>
    <td><%= applied_leave.leave.name %></td>
    <td><%= applied_leave.applied_from %></td>
    <td><%= applied_leave.applied_till %></td>
    <td>
      <%= render(BadgeComponent.new(variant: applied_leave.state)) do %>
        <%= t("applied_leave.labels.#{applied_leave.state}") %>
      <% end %>
    </td>
    <td class="text-end text-nowrap">
      <% if applied_leave.pending? && can?(:edit, applied_leave) %>
        <%= link_to edit_member_applied_leave_path(@user, applied_leave),
                    'aria-label': t('applied_leave.links.edit') do %>
          <i class='fa fa-bars'></i>
        <% end %>
      <% end %>
      <% if applied_leave.pending? && can?(:delete, applied_leave) %>
        <%= link_to member_applied_leave_path(@user, applied_leave), class: 'ms-3',
                    'aria-label': t('applied_leave.links.delete'),
                    data: { turbo_method: :delete,
                            turbo_confirm: t('applied_leave.messages.delete_confirm') } do %>
          <i class='fa fa-trash'></i>
        <% end %>
      <% end %>
    </td>
  </tr>
<% end %>
