<% applied_leaves.each do |applied_leave| %>
  <tr>
    <td><%= applied_leave.leave.name %></td>
    <td><%= applied_leave.applied_from %></td>
    <td><%= applied_leave.applied_till %></td>
    <td><%= t("applied_leave.labels.#{applied_leave.state}") %></td>
    <td>
      <% if applied_leave.pending? && can?(:edit, applied_leave) %>
        <%= link_to edit_member_applied_leave_path(@user, applied_leave) do %>
          <i class='fa fa-bars ms-3'></i>
        <% end %>
      <% end %>
      <% if applied_leave.pending? && can?(:delete, applied_leave) %>
        <%= link_to member_applied_leave_path(@user, applied_leave), data: { turbo_method: :delete, turbo_confirm: t('applied_leave.messages.delete_confirm') } do %>
          <i class='fa fa-trash ms-3'></i>
        <% end %>
      <% end %>
    </td>
  </tr>
<% end %>