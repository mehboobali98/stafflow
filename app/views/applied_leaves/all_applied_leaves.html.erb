<%= javascript_include_tag "show_applied_leaves" %>

<%= render(PageHeaderComponent.new(title: t('applied_leave.headings.applied_leaves'))) do |header| %>
  <% if can?(:create, AppliedLeave) && !current_user.account_owner? %>
    <% header.with_actions do %>
      <%= render(ButtonComponent.new(href: new_member_applied_leave_path(current_user))) do %>
        <%= t('applied_leave.links.apply_for_leave') %>
      <% end %>
    <% end %>
  <% end %>
  <% header.with_link { link_to t('leave.all'), leaves_path } %>
  <% unless current_user.account_owner? %>
    <% header.with_link { link_to t('user_leave.myappleaves'), member_applied_leaves_path(current_user) } %>
    <% header.with_link { link_to t('user_leave.myavleaves'), member_user_leaves_path(current_user) } %>
  <% end %>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <%= select_tag "filter", options_for_select(leave_states), prompt: t('applied_leave.headings.select_filter'), class: 'form-select w-auto' if can?(:filter_applied_leaves, AppliedLeave) %>
  <div id="submit_buttons" class="d-none">
    <%= render(ButtonComponent.new(variant: :success, size: :sm, id: 'approve_leaves_btn', class: 'me-2')) do %>
      <%= t('applied_leave.links.approve_leaves') if can?(:approve_leaves, AppliedLeave) %>
    <% end %>
    <%= render(ButtonComponent.new(variant: :danger, size: :sm, id: 'reject_leaves_btn')) do %>
      <%= t('applied_leave.links.reject_leaves') if can?(:reject_leaves, AppliedLeave) %>
    <% end %>
  </div>
</div>

<div id="applied_leaves_list_table">
  <%= render partial: 'applied_leaves_list', locals: { applied_leaves: @applied_leaves } %>
</div>

<% if @applied_leaves.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
