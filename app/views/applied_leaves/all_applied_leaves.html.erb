<%= javascript_pack_tag "show_applied_leaves" %>
<div class='pms-heading p-3'>
  <div class='row'>
    <div class='col-10'>
      <h2 class="mb-3"><%= t('applied_leave.headings.applied_leaves') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('applied_leave.links.apply_for_leave'), new_member_applied_leave_path(current_user), class: 'btn btn-primary mb-2' if can?(:create, AppliedLeave) && !current_user.account_owner? %>
    </div>
  </div>
  <%= link_to t('leave.all'), leaves_path, class: 'card-link' %>
  <% unless current_user.account_owner? %>
    <%= link_to t('user_leave.myappleaves'), member_applied_leaves_path(current_user), class: 'card-link' %>
    <%= link_to t('user_leave.myavleaves'), member_user_leaves_path(current_user), class: 'card-link' %>
  <% end %>
</div>
<br>
<br>
<div class='p-3'>
  <div class="d-flex justify-content-between">
    <%= select_tag "filter", options_for_select(leave_states), prompt: t('applied_leave.headings.select_filter'), class: 'form-select w-25 d-inline mb-2 p-2' if can?(:filter_applied_leaves, AppliedLeave) %>
    <div id="submit_buttons" class="d-none">
      <button type="button" id="approve_leaves_btn" class="btn btn-success mb-2 p-2 me-2"><%= t('applied_leave.links.approve_leaves') if can?(:approve_leaves, AppliedLeave) %></button>
      <button type="button" id="reject_leaves_btn" class="btn btn-danger mb-2 p-2"><%= t('applied_leave.links.reject_leaves') if can?(:reject_leaves, AppliedLeave) %></button>
    </div>
  </div>
  <div id="applied_leaves_list_table">
    <%= render partial: 'applied_leaves_list', locals: { applied_leaves: @applied_leaves } %>
  </div>
  <% if @applied_leaves.empty? %>
    <div class="d-flex justify-content-md-center align-items-center mt-5">
      <h1 class='text-muted'><%= t('nodata') %></h1>
    </div>
  <% end %>
</div>