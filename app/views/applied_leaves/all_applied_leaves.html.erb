<%= javascript_pack_tag "show_applied_leaves" %>
<%= render partial: 'shared/leaves_header', locals: { heading: t('applied_leave.headings.applied_leaves') } %>
<div class="container">
  <div class="d-flex justify-content-between">
    <%= select_tag "filter", options_for_select(leave_states), prompt: t('applied_leave.headings.select_filter'), class: 'form-select w-25 d-inline mb-2 p-2' if can?(:filter_applied_leaves, AppliedLeave) %>
    <div id="submit_buttons" class="d-none">
      <button type="button" id="approve_leaves_btn" class="btn btn-success mb-2 p-2 me-2"><%= t('applied_leave.links.approve_leaves') if can?(:approve_leaves, AppliedLeave) %></button>
      <button type="button" id="reject_leaves_btn" class="btn btn-danger mb-2 p-2"><%= t('applied_leave.links.reject_leaves') if can?(:reject_leaves, AppliedLeave) %></button>
    </div>
  </div>
  <div id="applied_leaves_list_table">
    <%= render partial: 'applied_leaves_list', locals: { applied_leaves: @applied_leaves } %>
  </div>
</div>