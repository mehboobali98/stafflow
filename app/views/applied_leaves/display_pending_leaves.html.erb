<div class="container">
  <h1> Pending Leaves </h1>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th> Applicant Name </th>
        <th> Leave Type </th>
        <th> Leave Duration </th>
        <th> Leave From </th>
        <th> Leave To </th>
        <th class="text-center" colspan="3"> Options </th>
      </tr>
    </thead>
    <tbody>
      <% @applied_leaves.each do |applied_leave| %>
        <tr>
          <% binding.pry %>
          <td><%= applied_leave.user_leave.user.email %></td>
          <td><%= applied_leave.user_leave.leave.name %></td>
          <td><%= applied_leave.leave_duration_name_from_id %></td>
          <td><%= applied_leave.applied_at %></td>
          <td><%= applied_leave.applied_till %></td>
          <td><%= link_to 'Show', applied_leave, class: 'btn btn-info' %></td>
          <td><%= link_to 'Accept', approve_leave_applied_leave_path(applied_leave), method: :post, class: 'btn btn-secondary' %></td>
          <td><%= link_to 'Reject', reject_leave_applied_leave_path(applied_leave), method: :post, class: 'btn btn-danger' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>