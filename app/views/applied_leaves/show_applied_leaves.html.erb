<%= javascript_pack_tag "applied_leaves" %>
<div class="container">
  <h1> Applied Leaves </h1>
  <br>
  <br>
  <%= form_tag approve_multiple_applied_leaves_path, method: :patch, local: false, remote: true, id: 'applied_leaves_form' do %>
    <%= submit_tag "Approve leaves", id: 'approve_leaves_btn' %>
    <%= submit_tag "Disapprove leaves", id: 'approve_leaves_btn' %>
    <%= select_tag "filter", options_for_select(['Select Filter',
      'Pending',
      'Accepted',
      'Rejected']), class: 'custom-select' %>
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th></th>
          <th> Applicant Name </th>
          <th> Leave Type </th>
          <th> Leave Duration </th>
          <th> Leave From </th>
          <th> Leave To </th>
          <th> Leave Status </th>
          <th class="text-center" colspan="3"> Options </th>
        </tr>
      </thead>
      <tbody id="applied_leaves_admin_table">
        <%= render partial: 'applied_leaves_admin_index', locals: { applied_leaves: @applied_leaves } %>
      </tbody>
    </table>
  <% end %>
</div>