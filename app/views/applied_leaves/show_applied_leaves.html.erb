<%= javascript_pack_tag "applied_leaves" %>
<div class="container">
  <h1> Applied Leaves </h1>
  <br>
  <br>
  <%= form_tag approve_multiple_applied_leaves_path, method: :post, local: false, remote: true, id: 'applied_leaves_form' do %>
    <%= submit_tag "Approve leaves", id: 'approve_leaves_btn' %>
    <%= submit_tag "Disapprove leaves", id: 'approve_leaves_btn' %>
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th></th>
          <th> Applicant Name </th>
          <th> Leave Type </th>
          <th> Leave Duration </th>
          <th> Leave From </th>
          <th> Leave To </th>
          <th> Leave Status </th>
          <th class="text-center" colspan="3"> Options </th>
        </tr>
      </thead>
      <tbody>
        <% @applied_leaves.each do |applied_leave| %>
          <tr>
            <td><%= check_box_tag "applied_leave_ids[]", applied_leave.id, false, disabled: !(applied_leave.pending?) %></td>
            <td><%= applied_leave.user_leave.user.email %></td>
            <td><%= applied_leave.user_leave.leave.name %></td>
            <td><%= applied_leave.leave_duration_name_from_id %></td>
            <td><%= applied_leave.applied_at %></td>
            <td><%= applied_leave.applied_till %></td>
            <td><%= applied_leave.state %></td>
            <td><%= link_to 'Show', applied_leave, class: 'btn btn-info' %></td>
            <td><%= link_to 'Accept', approve_applied_leave_path(applied_leave), method: :patch, class: 'btn btn-secondary' %></td>
            <td><%= link_to 'Reject', reject_applied_leave_path(applied_leave), method: :patch, class: 'btn btn-danger' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>