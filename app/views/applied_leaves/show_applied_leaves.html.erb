<%= javascript_pack_tag "applied_leaves" %>
<div class="container">
  <h1 class="my-2"><%= t('applied_leave.headings.applied_leaves') %></h1>
  <div class="d-flex justify-content-between">
    <%= select_tag "filter", options_for_select([
      'Pending',
      'Accepted',
      'Rejected'].freeze), class: 'w-25 d-inline mb-2 p-2' %>
    <form class="d-flex">
      <button type="button" id="approve_leaves_btn" class="btn btn-success mb-2 p-2 me-2"><%= link_to t('applied_leave.links.approve_leaves') %></button>
      <button type="button" id="reject_leaves_btn" class="btn btn-danger mb-2 p-2"><%= link_to t('applied_leave.links.reject_leaves') %></button>
    </form>
  </div>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th></th>
        <th><%= t('applied_leave.headings.applicant_email') %></th>
        <th><%= t('applied_leave.headings.leave_type') %></th>
        <th><%= t('applied_leave.headings.leave_duration') %></th>
        <th><%= t('applied_leave.headings.leave_from') %></th>
        <th><%= t('applied_leave.headings.leave_to') %></th>
        <th><%= t('applied_leave.headings.leave_status') %></th>
        <th class="text-center" colspan="3"><%= t('applied_leave.headings.options') %></th>
      </tr>
    </thead>
    <tbody id="applied_leaves_admin_table">
      <%= render partial: 'applied_leaves_admin_index', locals: { applied_leaves: @applied_leaves } %>
    </tbody>
  </table>
</div>