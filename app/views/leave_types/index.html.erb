<div class="container">
  <h1>Leave Types</h1>
  <%= link_to "New Leave Type", new_leave_type_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>Name</th>
      <th>Count Allowed</th>
      <th style="text-align:center" colspan="3">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @leave_types.each do |leave_type| %>
      <tr>
        <td><%= leave_type.name %></td>
        <td><%= leave_type.count %></td>
        <td><%= link_to "Show", leave_type, class: 
        'btn btn-info' %></td>
        <td><%= link_to "Edit", edit_leave_type_path(leave_type), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", leave_type, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>