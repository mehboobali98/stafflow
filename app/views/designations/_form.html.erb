<div class='d-flex justify-content-around'> 
  <div class='pb-3 w-50 m-4'>
    <h1><%= local_assigns[:heading] %></h1>
    <hr>
    <div  class='card bg-light p-4'>
      <%= form_for @designation do |form| %>
        <div class="field mb-3">
          <%= form.label t('designation.name_lable') %>
          <%= form.text_field :name, required: true, class: 'form-control' %>
        </div>
        <div class="field mb-3">
          <%= form.label t('designation.select_department') %>
          <%= form.select :department_id, options_from_collection_for_select(@departments, :id, :name),{ prompt:'select' },{ class: "form-control" } %>    
        </div>
        <div class="actions">
          <%= form.submit local_assigns[:label_to_show], class: 'btn btn-primary w-100 mt-3' %>
        </div>
      <% end %>
    </div>
  </div>
</div>