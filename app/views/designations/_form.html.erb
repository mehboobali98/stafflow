<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_for @designation do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :name, label: t('designation.name_lable'),
                                      required: true)) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :department_id,
                                      label: t('designation.select_department'))) do %>
      <%= form.collection_select :department_id, @departments, :id, :name,
                                 { prompt: t('forms.labels.select') }, { class: 'form-select' } %>
    <% end %>
    <%= render(ButtonComponent.new(type: 'submit')) { local_assigns[:label_to_show] } %>
  <% end %>
<% end %>
