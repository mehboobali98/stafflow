<div class="container">
  <h1 class="mt-1">Designations</h1>
  <%= link_to "New Designation", new_designation_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>Designation-Name</th>
      <th>Department-ID</th>
      <th style="text-align:center" colspan="3">Options</th>
  </thead>
  <tbody>
    <% @designations.each do |designation| %>
      <tr>
        <td><%= designation.designation_name %></td>
        <td><%= designation.department_id %></td>
        <td><%= link_to "Edit", edit_designation_path(designation), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", designation, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>