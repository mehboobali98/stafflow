<h1 class="mb-3 card-header"><%= t('designation.table_heading') %></h1>
<div class="container">
  <%= link_to t('designation.new_link_name'), new_designation_path, class: 'btn btn-outline-primary' if can?(:create, Designation) %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('designation.table_cell_one_name') %></th>
      <th><%= t('designation.table_cell_three_name') %></th>
      <th><%= t('designation.table_cell_two_name') %></th>
      <th></th>
    </thead>
    <tbody>
      <% designations.each do |designation| %>
        <tr>
          <td><%= designation.name %></td>
          <td><%= designation.users.size %></td>
          <td><%= designation.department.name %></td>
          <td>
            <%= link_to t('designation.edit_btn_message'), edit_designation_path(designation), class: 'btn btn-outline-secondary' %>
            <%= link_to t('designation.destroy_btn_message'), designation, method: :delete, data: { confirm: t('designation.sure_message') }, class: 'btn btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>