<%= render(PageHeaderComponent.new(title: t('designation.table_heading'))) do |header| %>
  <% if can?(:create, Designation) %>
    <% header.with_actions do %>
      <%= render(ButtonComponent.new(href: new_designation_path)) do %>
        <%= t('designation.new_link_name') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('designation.table_cell_one_name') %></th>
      <th><%= t('designation.table_cell_three_name') %></th>
      <th><%= t('designation.table_cell_two_name') %></th>
      <th class="text-end"><%= t('designation.table_options') %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% designations.each do |designation| %>
      <tr>
        <td><%= designation.name %></td>
        <td><%= designation.users.size %></td>
        <td><%= designation.department.name %></td>
        <td class="text-end text-nowrap">
          <%= link_to edit_designation_path(designation), 'aria-label': t('designation.links.edit') do %>
            <%= render(IconComponent.new(:'list')) %>
          <% end %>
          <%= link_to designation, class: 'ms-3', 'aria-label': t('designation.links.delete'),
                                   data: { turbo_method: :delete,
                                           turbo_confirm: t('designation.sure_message') } do %>
            <%= render(IconComponent.new(:'trash')) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<% if designations.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
