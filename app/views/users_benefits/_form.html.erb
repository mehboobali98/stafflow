<%= form_for [@user, @users_benefit], url: member_users_benefit_path do |form| %>
  <div class="row">
    <div class="col-md-4">
      <div class="mb-3">
        <%= form.label :amount, t('users_benefit.benefit_amount'), { class: 'form-label m-3' } %>
        <%= form.number_field :amount, { class: 'form-control m-3', required: true, placeholder: t('users_benefit.table.benefit_amount') } %>
      </div>
    <div>
    <%= form.submit t('form.button.submit'), class: 'btn btn-primary m-3' %>
  </div>
<% end %>