<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_for [@user, @users_benefit], url: member_users_benefit_path do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :amount, as: :number_field,
                                      label: t('users_benefit.benefit_amount'), required: true,
                                      placeholder: t('users_benefit.table.benefit_amount'))) %>
    <%= render(ButtonComponent.new(type: 'submit')) { t('form.button.submit') } %>
  <% end %>
<% end %>
