<% content_for :title, t('users_benefit.headings.users_benefits') %>
<%= render(PageHeaderComponent.new(title: t('users_benefit.headings.users_benefits'))) do |header| %>
  <% header.with_actions do %>
    <%= render(ButtonComponent.new(href: available_benefits_member_users_benefits_path(@user))) do %>
      <%= t('users_benefit.table.new_users_benefit') %>
    <% end %>
  <% end %>
  <% header.with_link { link_to t('benefits.all'), benefits_path } %>
<% end %>

<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('users_benefit.table.user_name') %></th>
      <th><%= t('users_benefit.table.benefit_name') %></th>
      <th><%= t('users_benefit.table.amount') %></th>
      <th class="text-end"><%= t('users_benefit.table.options') if can?(:update, UsersBenefit) %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% @users_benefits.each do |users_benefit| %>
      <tr>
        <td><%= users_benefit.user.full_name %></td>
        <td><%= users_benefit.benefit.name %></td>
        <td><%= users_benefit.amount %></td>
        <td class="text-end text-nowrap">
          <% if can?(:update, users_benefit) %>
            <%= link_to edit_member_users_benefit_path(@user, users_benefit),
                        'aria-label': t('users_benefit.links.edit') do %>
              <i class='fa fa-bars'></i>
            <% end %>
          <% end %>
          <% if can?(:destroy, users_benefit) %>
            <%= link_to member_users_benefit_path(@user, users_benefit), class: 'ms-3',
                        'aria-label': t('users_benefit.links.delete'),
                        data: { turbo_method: :delete, turbo_confirm: t('form.message.confirmation') } do %>
              <i class='fa fa-trash'></i>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<% if @users_benefits.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
<%= render partial: 'shared/pagination', locals: { resource: @users_benefits } %>
