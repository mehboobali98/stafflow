<div class='card-header'>
  <h1><%= t('users_benefit.headings.users_benefits') %></h1>
  <%= link_to t('benefits.all'), benefits_path %>
</div>
<div class="container">
  <%= link_to t('users_benefit.table.new_users_benefit'), available_benefits_member_users_benefits_path(@user), class: 'btn btn-outline-primary' if can?(:create, UsersBenefit) %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('users_benefit.table.user_name') %></th>
      <th><%= t('users_benefit.table.benefit_name') %></th>
      <th><%= t('users_benefit.table.amount') %></th>
      <th colspan="2"><%= t('users_benefit.table.options') if can?(:update, UsersBenefit) %></th>
    </tr>
  </thead>
  <tbody>
    <% @users_benefits.each do |users_benefit| %>
      <tr>  
        <td><%= users_benefit.user.full_name%></td>
        <td><%= users_benefit.benefit.name %></td>
        <td><%= users_benefit.amount %></td>
        <td><%= link_to t('form.button.update'), edit_member_users_benefit_path(@user, users_benefit), class: 'btn btn-secondary' if can?(:update, users_benefit) %></td>
        <td><%= link_to t('form.button.delete'), member_users_benefit_path(@user, users_benefit), method: :delete, data: { confirm: t('form.message.confirmation') }, class: 'btn btn-danger' if can?(:destroy, users_benefit) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= render partial: 'shared/pagination', locals: { resource: @benefits } %>
</div> 
