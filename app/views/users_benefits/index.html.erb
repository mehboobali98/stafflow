<div class="container">
  <h1><%= t('users_benefit.headings.users_benefits') %></h1>
  <%= link_to t('users_benefit.table.new_users_benefit'), new_member_users_benefit_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('users_benefit.table.user_name') %></th>
      <th><%= t('users_benefit.table.benefit_name') %></th>
      <th><%= t('users_benefit.table.amount') %></th>
      <th><%= t('users_benefit.table.status') %></th>
      <th colspan="2"><%= t('users_benefit.table.options') %></th>
    </tr>
  </thead>
  <tbody>
    <% @users_benefits.each do |users_benefit| %>
      <tr>  
        <td><%= users_benefit.user.full_name%></td>
        <td><%= users_benefit.benefit.name %></td>
        <td><%= users_benefit.amount %></td>
        <td><%= users_benefit.status ? t('users_benefit.table.active') : t('users_benefit.table.inactive') %></td>
        <td><%= link_to t('form.button.update'), member_users_benefit_path(@user, users_benefit), class: 'btn btn-secondary' %></td>
        <td><%= link_to t('form.button.delete'), member_users_benefit_path(@user, users_benefit), method: :delete, data: { confirm: t('form.message.confirmation') }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div> 
