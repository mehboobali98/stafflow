<div class='pms-heading ms-1'>  
  <div class='row'>
    <div class='col-10'>
      <h2><%= t('users_benefit.headings.users_benefits') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('users_benefit.table.new_users_benefit'), new_member_users_benefit_path, class: 'btn btn-primary mt-2' %>
    </div>
  </div>
  <%= link_to t('benefits.all'), benefits_path %>
</div>
<div>
  <br>
  <br>
  <table class="table table-hover">
    <thead class="pms-table-header">
      <th><%= t('users_benefit.table.user_name') %></th>
      <th><%= t('users_benefit.table.benefit_name') %></th>
      <th><%= t('users_benefit.table.amount') %></th>
      <th colspan="2"><%= t('users_benefit.table.options') %></th>
    </tr>
    </thead>
    <tbody>
      <% @users_benefits.each do |users_benefit| %>
        <tr>  
          <td><%= users_benefit.user.full_name%></td>
          <td><%= users_benefit.benefit.name %></td>
          <td><%= users_benefit.amount %></td>
          <td>
            <%= link_to t('form.button.update'), edit_member_users_benefit_path(@user, users_benefit), class: 'btn btn-secondary' %>
            <%= link_to t('form.button.delete'), member_users_benefit_path(@user, users_benefit), method: :delete, data: { confirm: t('form.message.confirmation') }, class: 'btn btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render partial: 'shared/pagination', locals: { resource: @users_benefits } %>
</div> 
