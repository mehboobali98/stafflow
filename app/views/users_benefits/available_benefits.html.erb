<% content_for :title, t('users_benefit.table.new_users_benefit') %>
<%= render(PageHeaderComponent.new(title: t('users_benefit.table.new_users_benefit'))) %>

<% if @available_benefits.present? %>
  <%= form_with model: [@user, @users_benefits],
                url: mass_create_member_users_benefits_path(@user), local: true do |form| %>
    <%= render(TableComponent.new(class: 'table-bordered')) do |table| %>
      <% table.with_head do %>
        <tr>
          <th><%= t('users_benefit.table.select') %></th>
          <th><%= t('users_benefit.table.benefit_name') %></th>
          <th><%= t('users_benefit.table.amount') %></th>
        </tr>
      <% end %>
      <% table.with_body do %>
        <% @available_benefits.each do |benefit| %>
          <tr data-controller="toggle-field">
            <td>
              <%= check_box_tag '', nil, false, class: 'new_user_benefit',
                                data: { action: 'change->toggle-field#toggle' } %>
            </td>
            <td><%= benefit.name %></td>
            <td>
              <%= number_field_tag "users_benefit[#{benefit.id}]", benefit.default_amount, disabled: true,
                                   id: "number_field_#{benefit.id}", class: 'form-control w-auto',
                                   data: { 'toggle-field-target': 'field' } %>
            </td>
          </tr>
        <% end %>
      <% end %>
    <% end %>
    <%= render(ButtonComponent.new(type: 'submit')) { t('form.button.submit') } %>
  <% end %>
<% else %>
  <%= render(EmptyStateComponent.new(title: t('users_benefit.validation.all_benefits_alloted'))) %>
<% end %>
