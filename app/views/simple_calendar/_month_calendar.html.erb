<div class="simple-calendar container-fluid">
  <div class="calendar-heading d-flex flex-row justify-content-between">
    <%= link_to calendar.url_for_previous_view, class: 'btn btn-outline-dark my-2', remote: true do %>
      <i class="fas fa-chevron-left"></i>
    <% end %>
    <span class="calendar-title font-weight-bold my-2"><u><%= t('date.month_names')[@start_date.month] %> <%= @start_date.year %></u></span>
    <%= link_to calendar.url_for_next_view, class: 'btn btn-outline-dark my-2', remote: true do %>
      <i class="fas fa-chevron-right"></i>
    <% end %>
  </div>
  <table class="table">
    <thead>
      <tr>
        <% date_range.slice(0, 7).each do |day| %>
          <th class="text-sm text-grey-darkest"><%= t('date.abbr_day_names')[day.wday] %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <%= content_tag :td, class: calendar.td_classes_for(day) do %>
              <div class="text-sm text-grey-darker"><% passed_block.call day, sorted_events.fetch(day, []) %></div>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>