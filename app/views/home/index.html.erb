
<%=@total_companies.each do |company|%>
<div class='row'>
  <div class='col-3'>
  </div>
  <div class='col-6'>
    <div class='card text-center w-75 m-2'>
      <h2 class='card-header'>Companies-List</h2>
      <div class='card-body'>
        <h3><%= company.name %></h3>
      </div>
    </div>
  </div>
  <div class='col-3 text-end'>
    <%= link_to "login", new_user_session_url(subdomain:company.subdomain), class: 'btn btn-dark m-3' %>
  </div>
</div>
<%end%>
