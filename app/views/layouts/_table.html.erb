<!--This File is for table-reference! Change it according to your need-->
<div class="container">
  <h1>Department</h1>
  <%= link_to "New Department", new_department_path, class: 'btn btn-outline-primary' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>Name</th>
      <th style="text-align:center" colspan="3">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @departments.each do |department| %>
      <tr>
        <td><%= department.name %></td>
        <td><%= link_to "Show", department, class:'btn btn-info' %></td>
        <td><%= link_to "Edit", edit_department_path(department), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", department, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @departments.empty? %>
  <div class="d-flex justify-content-md-center align-items-center mt-5">
    <h1 class='text-muted'><%= t('nodata') %></h1>
  </div>
<% end %>
</div>