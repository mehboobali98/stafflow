<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/head" %>
  <body>
    <%= render partial: "shared/flash_message" %>
    <div class="auth-shell">
      <div class="card auth-card">
        <div class="auth-card__brand">
          <h4 class="auth-card__mark"><%= t('appname') %></h4>
          <h5 class="auth-card__tagline"><%= t('labels.byteam') %></h5>
        </div>
        <hr>
        <div class="card-body">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
