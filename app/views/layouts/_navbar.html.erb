<%= javascript_pack_tag 'navbar', 'data-turbolinks-track': 'reload' %>
<nav class='navbar navbar-icon-top navbar-expand-lg navbar-dark bg-primary'>
  <div class='container-fluid'>
    <h1 class='navbar-brand ms-3 lead'><%= @current_company&.name %></h1>
    <form class='d-flex'>
      <div>
        <%= link_to notifications_path, class: 'notification' do %>
          <i class='fa fa-bell fa-lg'></i>
          <span id='notifications_count' class="badge">0</span>
        <% end %>
      </div>
      <input class='form-control me-2' type='search' placeholder='Search' aria-label='Search'>
      <button class='btn btn-dark' type='submit'><%= t('navbar.search') %></button>
    </form>
  </div>
</nav>
