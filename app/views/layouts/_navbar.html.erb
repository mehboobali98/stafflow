<%= javascript_pack_tag 'navbar', 'data-turbolinks-track': 'reload' %>
<nav class='navbar navbar-icon-top navbar-expand-lg navbar-dark bg-primary'>
  <div class='container-fluid p-1'>
    <h1 class='navbar-brand ms-3'><%= @current_company.name if !@current_company.nil? %></h1>
      <form class='d-flex'>
        <div>
          <%= link_to notifications_path, class: 'nav-item text-white me-5' do %>
            <i class='fa fa-bell fa-lg'>
              </i><span class='counter counter-lg border border-danger p-1 ms-1 bg-danger ps-2 pe-2' id='notifications_count'></span>
            </i>
          <% end %>
        </div>
        <input class='form-control me-2' type='search' placeholder='Search' aria-label='Search'>
        <button class='btn btn-outline-light' type='submit'>Search</button>
        <%= link_to 'C-', destroy_user_session_path, method: :delete, class: 'ms-3 btn btn-outline-light' %> 
      </form>
  </div>
</nav>
