<%= javascript_pack_tag 'navbar', 'data-turbolinks-track': 'reload' %>
<nav class="navbar sticky-top navbar-light bg-secondary">
  <div class="container-fluid">
    <h2 class="ms-3 mt-2 text-white" href="#">KDB</h2>
    <div class='d-flex justify-content-center align-items-center'>
        <%= link_to notifications_path do %>
        <div class='d-inline text-white p-3'>
        <%= image_tag 'bell.svg', class: 'notification-icon text-white' %>
        <div class='card-header bg-danger notification-counter d-inline'>
          <span id='notifications_count'></span>
        </div>
        </div>
        <% end %>
      <%= link_to 'Logout', destroy_user_session_path, method: :delete, class: 'ms-3 btn btn-danger p-2' %> 
    </div>
  </div>
</nav>