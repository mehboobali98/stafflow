<!DOCTYPE html>
<html>
  <head>
    <title>PMS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application' %>
  </head>

  <body>
  <% if notice %>
    <%= notice %>
  <% elsif alert %>
    <%= alert %>
  <% end %>
    <%= yield %>
  </body>
</html>
