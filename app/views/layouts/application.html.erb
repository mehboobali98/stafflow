<!DOCTYPE html>
<html>
  <head>
    <title>PMS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'sidebar' %>
    <%= stylesheet_link_tag 'dashboard' %>
    <%= javascript_pack_tag 'sidebar', 'data-turbolinks-track': 'reload' %>
  </head>
  <body>
    <div class="modal fade" id="modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true"></div>
    <%= render partial: "shared/sidebar" %>
    <div class="home-content">
      <%= render partial: "shared/dashboard_navbar" %>
      <%= render partial: "shared/flash_message" %>
      <div class='card-header'>
      <%= render_breadcrumbs separator: '/' %>
      </div>
      <%= yield %>
    </div>
  </body>
</html>