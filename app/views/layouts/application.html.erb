<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/head", stylesheets: %w[sidebar dashboard pagination] %>
  <body data-controller="sidebar">
    <div class="modal fade" tabindex="-1" aria-hidden="true" role="dialog" aria-modal="true"
         aria-labelledby="modal_title" data-controller="modal">
      <%= turbo_frame_tag 'modal', data: { modal_target: 'content' } %>
    </div>
    <%= render partial: "shared/sidebar" %>
    <div class="home-content" data-sidebar-target="content">
      <%= render partial: "shared/dashboard_navbar" %>
      <div id="flash_message"><%= render partial: "shared/flash_message" %></div>
      <div class="page-shell">
        <nav class="breadcrumbs"><%= render_breadcrumbs separator: ' / ' %></nav>
        <%= yield %>
      </div>
    </div>
  </body>
</html>