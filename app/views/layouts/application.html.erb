<!DOCTYPE html>
<html>
  <head>
    <title>PMS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'sidebar' %>
    <%= javascript_pack_tag 'sidebar', 'data-turbolinks-track': 'reload' %>
  </head>
  <body>
    <div class="modal fade" id="modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true"></div>
    <div class="row body-wrapper">
      <div class="col-sm-2 sidebar-wrapper">
        <%= render partial: "layouts/sidebar" %>
      </div>
      <div class="col-sm-9">
        <div id="flash_message">
          <%= render partial: "shared/flash_message" %>
        </div>
        <%= render_breadcrumbs %>
        <%= yield %>
      </div>
    </div>
    <%= render partial: "layouts/footer" %>
  </body>
</html>