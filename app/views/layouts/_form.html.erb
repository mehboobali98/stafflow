<!--This File is for form-reference! Change it according to your need-->
<div class="container">
  <div class="row justify-content-center">
    <div class="col-4">
      <h1> <%= heading%></h1>
      <% if event.errors.any? %>
        <div>
          <ul>
            <% event.errors.full_messages.each do |message| %>
              <li class='text-danger'><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= form_with model: event, local:true, :html => {'class' => 'card p-3 bg-light'} do |form| %>
        <div class="form-group mb-3">
          <%= form.label :name, 'Event name ' %>
          <%= form.text_field :name, required: true, class: 'form-control', placeholder: "Enter event name"%>
        </div>
        <div class="input-group mb-3 row">
          <div class="col-md-6">
            <%= form.label :start_date_str, 'Event date ' %>
            <%= form.date_field :start_date_str, required: true, class: "form-control"%>
          </div>
          <div class="col-md-6">
            <%= form.label :start_time_str, 'Event time ' %>
            <%= form.time_field :start_time_str, required: true, class: "form-control"%>
          </div>
        </div>
        <div>
          <%= form.submit class: 'card-link btn btn-primary'%>
        </div>
      <% end %>
    </div>
  </div>
</div>