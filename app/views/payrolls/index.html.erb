<div class="container">
  <h1>Payrolls</h1>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>Salary Item</th>
      <th>Amount</th>
    </thead>
    <tbody>
      <tr>
        <td>Base Salary</td>
        <td><%=@payroll.user.base_salary%></td>
      </tr>
      <tr>
        <td>Salary after Tax</td>
        <td><%=@payroll.salary_after_tax%></td>
      </tr>
      <%@user_benefit.each do |user_benefit|%>
      <tr>
        <td><%=user_benefit.benefit.name%></td>
        <td><%=user_benefit.amount%></td>
      </tr>
      <%end%>
      <tr>
        <td>Gross Salary</td>
        <td><%=@gross_salary%></td>
      </tr>
    </tbody>
  </table> 
</div> 
