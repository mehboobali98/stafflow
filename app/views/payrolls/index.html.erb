<div class = "table-responsive">
  <table class="table table-striped table-bordered">
    <thead class="blue">
      <tr class = "table-striped">
        <th style = 'text-align:center' style = 'text-align:top' scope="col">Basic Salary</th>
        <th style = 'text-align:center' scope="col">Tax Deduction</th>
        <th style = 'text-align:center' scope="col">Bonus</th>
        <th style = 'text-align:center' scope="col">Compensatory Pay</th>
        <th style = 'text-align:center' scope="col">Residence Allowance</th>
        <th style = 'text-align:center' scope="col">Travel Allowance</th>
        <th style = 'text-align:center' scope="col">GYM Allowance</th>
        <th style = 'text-align:center' scope="col">Training & Development Policy Reimbursement</th>
        <th style = 'text-align:center' scope="col">Coupon Reimbursement</th>
        <th style = 'text-align:center' scope="col">Device Policy Reimbursement</th>
        <th style = 'text-align:center' scope="col">Miscellaneous Additions</th>
        <th style = 'text-align:center' style = 'text-align:top' scope="col">EOBI</th>
        <th style = 'text-align:center' scope="col">Provident Fund</th>
      </tr>
    </thead>
    <tbody>
      <% @payrolls.each do |payroll| %>
      <tr class = "table-striped">
        <td style = 'text-align:center'><%=payroll.base_salary%></td>
        <td style = 'text-align:center'><%=payroll.tax%></td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
        <td style = 'text-align:center'>0</td>
      </tr>
      <%end%>
    </tbody>
  </table>
</div>