<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_for @department do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :name, label: t('department.name_lable'),
                                      required: true)) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :avatar, as: :file_field,
                                      label: t('department.select_image_lable'))) %>
    <%= render(ButtonComponent.new(type: 'submit')) { local_assigns[:label_to_show] } %>
  <% end %>
<% end %>
