<div class='d-flex justify-content-around'> 
  <div class='pb-3 w-50 m-4'>
    <h1><%= local_assigns[:heading] %></h1>
    <hr>
    <div class='card bg-light p-4'>
      <%= form_for @department do |form| %>
        <div class="form-group">
          <%= form.label t('department.name_lable') %>
          <%= form.text_field :name, required: true, class: 'form-control' %>
          <%= form.label t('department.select_image_lable') %>
          <%= form.file_field :avatar, class: 'form-control' %>
        </div>
        <div>
          <%= form.submit local_assigns[:label_to_show], class: 'card-link btn btn-primary w-100 mt-3' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
