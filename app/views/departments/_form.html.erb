<%= form_for @department do |f| %>
  <div class=" row">
    <div class="col-md-4">
      <div class="mb-3">
        <%= f.label :Department_Name, { class: "form-label"} %>
        <%= f.text_field :name, { class: "form-control", placeholder: "Department Name" } %>
      </div>
      <div class="mb-3 ">
        <%= f.label :Image, { class: "form-label"} %></br>
        <%= f.file_field :image_url %>
      </div>
      <%= f.submit "Submit", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
