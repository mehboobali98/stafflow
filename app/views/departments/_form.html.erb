<div class="container">
  <div class="row  mt-4">
    <div class="col-4">
      <h1><%= @heading %></h1>
      <%= form_for @department do |f| %>
        <div class="form-group mb-3">
          <%= f.label :Department_Name, 'Department name ' %>
          <%= f.text_field :name, required: true, class: 'form-control', placeholder: "Enter Department Name" %>
        </div>
        <div class="input-group mb-3 row">
          <div class="col-md-6">
            <%= f.label :Image, { class: "form-label"} %></br>
            <%= f.file_field :image_url %>
          </div>
        </div>
        <div>
          <%= f.submit class: 'card-link btn btn-dark' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
