<h1 class="mt-1 card-header"><%= t('department.table_heading') %></h1>
<div class="container">
  <%= link_to t('department.new_link_name'), new_department_path, class: 'btn btn-outline-primary' if can?(:create, Department) %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th></th>
      <th><%= t('department.name') %></th>
      <th><%= t('department.number_of_employees') %></th>
      <th></th>
    </thead>
    <tbody>
      <% departments.each do |department| %>
        <tr>
          <td class="w-25">
            <% if department.avatar.present? %>
              <%= image_tag department.avatar.url(:medium), class:'w-25' %>
            <% else %>
              <%= image_tag 'department', class:'w-25' %>
            <% end %>
          </td>
          <td><%= department.name %></td>
          <td><%= department.users.size %></td>
          <td><%= link_to t('department.edit_btn_message'), edit_department_path(department), class: 'btn btn-outline-secondary' if can?(:update, department) %>
              <%= link_to t('department.destroy_btn_message'), department, method: :delete, data: { confirm: t('department.sure_message') }, class: 'btn btn-danger' if can?(:destroy, department) %> 
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
