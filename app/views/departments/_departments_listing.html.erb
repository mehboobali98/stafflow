<div class="container">
  <h1 class="mt-1"><%= t('department.table_heading') %></h1>
  <%= link_to t('department.new_link_name'), new_department_path, class: 'btn btn-outline-dark' if can?(:create, Department) %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('department.table_heading') %></th>
      <th class="text-center" colspan="2"><%= t('department.table_options') %></th>
    </thead>
    <tbody>
      <% departments.each do |department| %>
        <tr>
          <td><%= department.name %></td>
          <td><%= link_to t('department.edit_btn_message'), edit_department_path(department), class: 'btn btn-secondary' if can?(:update, department) %></td>
          <td><%= link_to t('department.destroy_btn_message'), department, method: :delete, data: { confirm: t('department.sure_message') }, class: 'btn btn-danger' if can?(:destroy, department) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>