<div class='pms-heading row ms-1'>
  <div class='col-10'>
    <h2 class="mt-1"><%= t('department.table_heading') %></h2>
  </div>
  <div class='col-2'>
    <%= link_to t('department.new_link_name'), new_department_path, class: 'btn btn-primary mt-1' if can?(:create, Department) %>
  </div>
</div>
<div>
  <br>
  <br>
  <table class="table table-hover mx-3 me-5">
    <thead class="pms-table-header p-3 table-borderless">
      <th><%= t('department.name') %></th>
      <th colspan="2"><%= t('department.options') %></th>
    </thead>
    <tbody>
      <% departments.each do |department| %>
        <tr>
          <td><%= department.name %></td>
          <td>
            <% if can?(:update, department) %>
              <%= link_to edit_department_path(department) do %>
                <i class='fa fa-bars ms-3'></i>
              <% end %>
            <% end %>
            <% if can?(:destroy, department) %>
              <%= link_to department, method: :delete, data: { confirm: t('department.sure_message') } do %>
                <i class='fa fa-trash ms-3'></i>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
