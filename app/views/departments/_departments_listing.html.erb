<%= render(PageHeaderComponent.new(title: t('department.table_heading'))) do |header| %>
  <% if can?(:create, Department) %>
    <% header.with_actions do %>
      <%= render(ButtonComponent.new(href: new_department_path)) do %>
        <%= t('department.new_link_name') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('department.name') %></th>
      <th class="text-end"><%= t('department.options') %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% departments.each do |department| %>
      <tr>
        <td><%= department.name %></td>
        <td class="text-end text-nowrap">
          <% if can?(:update, department) %>
            <%= link_to edit_department_path(department), 'aria-label': t('department.links.edit') do %>
              <i class='fa fa-bars'></i>
            <% end %>
          <% end %>
          <% if can?(:destroy, department) %>
            <%= link_to department, class: 'ms-3', 'aria-label': t('department.links.delete'),
                                    data: { turbo_method: :delete,
                                            turbo_confirm: t('department.sure_message') } do %>
              <i class='fa fa-trash'></i>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<% if departments.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
