<div class="container">
  <h1 class="mt-1"><%= I18n.t 'department.table_heading' %></h1>
  <%= link_to I18n.t('department.new_link_name'), new_department_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= I18n.t 'department.table_heading'%></th>
      <th style="text-align:center" colspan="3"><%= I18n.t 'department.table_options'%></th>
    </tr>
  </thead>
  <tbody>
    <% @departments.each do |department| %>
      <tr>
        <td><%= department.name %></td>
        <td><%= link_to "Edit", edit_department_path(department), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", department, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>