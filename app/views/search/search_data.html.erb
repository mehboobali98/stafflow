<% if @results.total_count == 0 %>
  <div class='d-flex justify-content-around'>
    <div class='card w-50 p-5 mt-5'>
      <div class='row px-5'>
        <div class='col-12 d-flex justify-content-start'>
          <h4 class='border border-primary rounded bg-primary text-white p-2'>Search Results </h4>
        </div>
      </div>
      <hr>
      <div class='card-body px-5'>
		    <h1 class='text-center text-muted' mt-4>No Data Found</h1>
		    <div class='d-flex justify-content-around'>
		      <%= image_tag("nodata.svg", class: 'illustration') %>
		    </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="container">
    <div class="m-3 p-4">
	    <table class='table table-striped table-hover'>
        <thead class='table-dark'>
          <th><%= t('forms.labels.full_name') %></th>
          <th><%= t('forms.labels.email') %></th>
          <th>Role</th>
          <th>Department</th>
          <th>Designation</th>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <tr>
              <% if result.instance_of? User %>
                <td><%= result.full_name.presence %></td>
                <td><%= result.email.presence %></td>
                <td colspan="3"><%= result.role_name if result.role_id.present? %></td>
              <% elsif result.instance_of? Department %>
                <td></td><td></td><td></td>
                <td><%= result.name %></td><td></td>
              <% else %>
                <td></td><td></td><td></td><td></td>
                <td><%= result.name %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

