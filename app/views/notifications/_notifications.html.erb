<div class='please-scroll'>
  <div class='list-group js-notifications-list'>
    <% notifications.each do |notification| %>
      <label class="list-group-item">
        <%= check_box_tag 'ids[]', notification.id, false, id: "notification_#{notification.id}",
                                                           class: 'form-check-input me-2',
                                                           data: { 'checkbox-group-target': 'item',
                                                                   action: 'change->checkbox-group#refresh' } %>
        <div class="d-inline notification<%= notification.status %>">
          <%= notification.body %>
        </div>
      </label>
    <% end %>
  </div>
</div>
<%= render partial: 'shared/pagination', locals: { resource: notifications } %>
