<%= javascript_pack_tag 'settings', 'data-turbolinks-track': 'reload' %>
<div class='pms-heading p-2'>
  <h1><%= t('settings.title') %></h1>
</div>
<div class='m-0 p-0'>
  <div class='container'>
    <div class='w-75 mt-5'>
      <%= form_with scope: :setting, url: setting_path(setting), method: :patch, local: true, id: 'setting_form' do |form| %>
        <div class='card p-3 card-body'>
          <div class='m-3 card p-3'>
            <%= form.label :tax_rate, class: 'form-label' %>
            <%= form.number_field :tax_rate, in: MIN_TAX_RATE..MAX_TAX_RATE, step: 0.1, required: true, class: 'form-control' %>
          </div>
          <div class='m-3 card p-3'>
            <%= form.label :reset_date, class: 'form-label' %>
            <%= form.date_field :leave_resets_at, required: true, class: 'form-control' %>
          </div>
        </div>
        <%= form.submit disabled: true, class: 'btn btn-primary my-3 pull-right', id: 'submit_button' %>
      <% end %>
    </div>
  </div>
</div>