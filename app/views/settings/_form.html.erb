<%= render(PageHeaderComponent.new(title: t('settings.title'))) %>

<%= form_with scope: :setting, url: setting_path(setting), method: :patch, local: true, id: 'setting_form',
              data: { controller: 'dirty-form', action: 'change->dirty-form#enable input->dirty-form#enable' } do |form| %>
  <%= render(CardComponent.new(class: 'w-75')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :tax_rate, as: :number_field,
                                      in: MIN_TAX_RATE..MAX_TAX_RATE, step: 0.1, required: true)) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :leave_resets_at, as: :date_field,
                                      required: true)) %>
    <%= render(ButtonComponent.new(type: 'submit', id: 'submit_button', disabled: true,
                                   data: { 'dirty-form-target': 'submit' })) do %>
      <%= t('settings.save') %>
    <% end %>
  <% end %>
<% end %>
