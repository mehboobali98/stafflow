<h1><%= I18n.t('headings.settings') %></h1>
<%= form_with model: @setting do |form| %>
  <div>
    <%= form.label :tax %>
    <%= form.text_field :tax %>
  </div>

  <div>
    <%= form.label :Red %>
    <%= form.radio_button :theme, 'red' %>
    <%= form.label :Blue %>
    <%= form.radio_button :theme, 'blue' %>
    <%= form.label :Black %>
    <%= form.radio_button :theme, 'black' %>
  </div>
  <%= form.submit %>

<% end %>
