<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_for @benefit do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :name, label: t('benefit.label.benefit_name'),
                                      required: true, placeholder: t('form.field.benefit_name'))) %>
    <%= render(FormFieldComponent.new(form: form, attribute: :default_amount, as: :number_field,
                                      label: t('benefit.label.amount'), required: true,
                                      placeholder: t('benefit.label.amount'))) %>
    <%= render(ButtonComponent.new(type: 'submit')) { t('form.button.submit') } %>
  <% end %>
<% end %>
