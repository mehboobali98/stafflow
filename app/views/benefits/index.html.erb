<% content_for :title, t('benefit.headings.benefit') %>
<%= render(PageHeaderComponent.new(title: t('benefit.headings.benefit'))) do |header| %>
  <% header.with_actions do %>
    <%= render(ButtonComponent.new(href: new_benefit_path)) do %>
      <%= t('form.button.create_benefit') %>
    <% end %>
  <% end %>
  <% unless current_user.account_owner? %>
    <% header.with_link { link_to t('benefits.my'), member_users_benefits_path(current_user) } %>
  <% end %>
<% end %>

<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('benefit.table.name') %></th>
      <th><%= t('benefit.table.amount') %></th>
      <th class="text-end"><%= t('benefit.table.options') if can?(:edit, Benefit) %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% @benefits.each do |benefit| %>
      <tr>
        <td><%= benefit.name %></td>
        <td><%= benefit.default_amount %></td>
        <td class="text-end text-nowrap">
          <% if can?(:update, benefit) %>
            <%= link_to edit_benefit_path(benefit), 'aria-label': t('benefit.links.edit') do %>
              <i class='fa fa-bars'></i>
            <% end %>
          <% end %>
          <% if can?(:destroy, benefit) %>
            <%= link_to benefit, class: 'ms-3', 'aria-label': t('benefit.links.delete'),
                                 data: { turbo_method: :delete,
                                         turbo_confirm: t('form.message.confirmation') } do %>
              <i class='fa fa-trash'></i>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<% if @benefits.empty? %>
  <%= render(EmptyStateComponent.new(title: t('nodata'))) %>
<% end %>
<%= render partial: 'shared/pagination', locals: { resource: @benefits } %>
