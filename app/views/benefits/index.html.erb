<div class='pms-heading ms-1'>  
  <div class='row'>
    <div class='col-10'>
      <h2><%= t('benefit.headings.benefit') %></h2>
    </div>
    <div class='col-2'>
      <%= link_to t('form.button.create_benefit'), new_benefit_path, class: 'btn btn-primary mt-2' %>
    </div>
  </div>
  <%= link_to t('benefits.my'), member_users_benefits_path(current_user) unless current_user.account_owner? %>
</div>
<div>
  <br>
  <br>
  <table class="table table-hover">
    <thead class="pms-table-header">
      <th><%= t('benefit.table.name') %></th>
      <th><%= t('benefit.table.amount') %></th>
      <th colspan="2"><%= t('benefit.table.options') if can?(:edit, Benefit) %></th>
    </tr>
  </thead>
  <tbody>
    <% @benefits.each do |benefit| %>
      <tr>
        <td><%= benefit.name %></td>
        <td><%= benefit.default_amount %></td>
        <td>
          <% if can?(:update, benefit) %>
            <%= link_to edit_benefit_path(benefit) do %>
              <i class='fa fa-bars ms-3'></i>
            <% end %>
          <% end %>
          <% if can?(:destroy, benefit) %>
            <%= link_to benefit, method: :delete, data: { confirm: t('form.message.confirmation') } do %>
              <i class='fa fa-trash ms-3'></i>
            <% end %>
          <% end %>
        </td>
      </tr>  
    <% end %>
  </tbody>
</table>
<%= render partial: 'shared/pagination', locals: { resource: @benefits } %>
</div> 