<div class="container">
  <h1><%= t('benefit.headings.benefit') %></h1>
  <%= link_to t('form.button.create_benefit'), new_benefit_path, class: 'btn btn-outline-dark' if can?(:create,  @benefits.first) %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('benefit.table.name') %></th>
      <th><%= t('benefit.table.type') %></th>
      <th colspan="2"><%= t('benefit.table.options') if can?(:edit, @benefits.first) %></th>
    </tr>
  </thead>
  <tbody>
    <% @benefits.each do |benefit| %>
      <% if benefit.status %>  
        <tr>
          <td><%= benefit.name %></td>
          <td><%= benefit.default_amount %></td>
          <td><%= link_to t('form.button.update'), benefit_path(benefit), class: 'btn btn-secondary' if can?(:update, benefit) %></td>
          <td><%= link_to t('form.button.delete'), benefit, method: :delete, data: { confirm: t('form.message.confirmation') }, class: 'btn btn-danger' if can?(:destroy, benefit) %></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
</div> 