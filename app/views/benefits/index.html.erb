<%= stylesheet_link_tag 'pagination' %>
<div class="container">
  <h1><%= t('benefit.headings.benefit') %></h1>
  <%= link_to t('form.button.create_benefit'), new_benefit_path, class: 'btn btn-outline-dark' if can?(:create,  Benefit) %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= t('benefit.table.name') %></th>
      <th><%= t('benefit.table.amount') %></th>
      <th colspan="2"><%= t('benefit.table.options') if can?(:edit, Benefit) %></th>
    </tr>
  </thead>
  <tbody>
    <% @benefits.each do |benefit| %>
      <tr>
        <td><%= benefit.name %></td>
        <td><%= number_to_currency(benefit.default_amount, unit: t('currency.rupees')) %></td>
        <td><%= link_to t('form.button.update'), edit_benefit_path(benefit), class: 'btn btn-secondary' if can?(:update, benefit) %></td>
        <td><%= link_to t('form.button.delete'), benefit, method: :delete, data: { confirm: t('form.message.confirmation') }, class: 'btn btn-danger' if can?(:destroy, benefit) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= render partial: 'shared/pagination', locals: { resource: @benefits } %>
</div> 