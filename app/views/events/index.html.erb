<div class="container">
  <h1><%= I18n.t('event.forms.headings.event') %></h1>
  <%= link_to I18n.t('event.forms.links.create'), new_event_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th><%= I18n.t('event.forms.headings.name') %></th>
      <th><%= I18n.t('event.forms.headings.starts_at') %></th>
      <th style="text-align:center" colspan="3">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr>
        <td><%= event.name %></td>
        <td><%= format_date(event.start_time) %></td>
        <td><%= link_to I18n.t('event.forms.links.show'), event, class: 
        'btn btn-info' %></td>
        <td><%= link_to I18n.t('event.forms.links.edit'), edit_event_path(event), class: 'btn btn-secondary' %></td>
        <td><%= link_to I18n.t('event.forms.links.delete'), event, method: :delete, data: { confirm: I18n.t('event.forms.links.confirmation.deletion') }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>