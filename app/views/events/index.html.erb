<div class="container">
  <h1>Events</h1>
  <%= link_to "New Event", new_event_path, class: 'btn btn-outline-dark' %>
  <br>
  <br>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <th>Name</th>
      <th>Starts at</th>
      <th style="text-align:center" colspan="3">Options</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr>
        <td><%= event.name %></td>
        <td><%= format_date(event.start_time) %></td>
        <td><%= link_to "Show", event, class: 
        'btn btn-info' %></td>
        <td><%= link_to "Edit", edit_event_path(event), class: 'btn btn-secondary' %></td>
        <td><%= link_to "Destroy", event, method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>