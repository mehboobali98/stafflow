<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th><%= t('event.forms.headings.name') %></th>
      <th><%= t('event.forms.headings.starts_at') %></th>
      <th class="text-center" colspan="3"><%= t('event.forms.headings.option') %></th>
    </tr>
  </thead>
  <tbody>
    <% events.each do |event| %>
      <tr>
        <td><%= truncate_event_name(event.name) %></td>
        <td><%= format_date(event.starts_at) %></td>
        <td><%= link_to t('event.forms.links.show'), event, class: 'btn btn-info' if can?(:show, event) %></td>
        <td><%= link_to t('event.forms.links.edit'), edit_event_path(event), class: 'btn btn-secondary' if can?(:edit, event) %></td>
        <td><%= link_to t('event.forms.links.delete'), event, method: :delete, data: { confirm: t('event.forms.confirmation.deletion') }, class: 'btn btn-danger' if can?(:delete, event) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= render partial: 'shared/pagination', locals: { resource: events } %>