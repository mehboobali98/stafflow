<%= render(TableComponent.new(class: 'table-hover')) do |table| %>
  <% table.with_head do %>
    <tr>
      <th><%= t('event.forms.headings.name') %></th>
      <th><%= t('event.forms.headings.starts_at') %></th>
      <th class="text-end"><%= t('event.forms.headings.option') %></th>
    </tr>
  <% end %>
  <% table.with_body do %>
    <% events.each do |event| %>
      <tr>
        <td><%= truncate_event_name(event.name) %></td>
        <td><%= format_date(event.starts_at) %></td>
        <td class="text-end text-nowrap">
          <% if can?(:show, event) %>
            <%= link_to event, 'aria-label': t('event.links.view') do %>
              <i class='fa fa-eye fa-lg'></i>
            <% end %>
          <% end %>
          <% if can?(:edit, event) %>
            <%= link_to edit_event_path(event), class: 'ms-3', 'aria-label': t('event.links.edit') do %>
              <i class='fa fa-bars'></i>
            <% end %>
          <% end %>
          <% if can?(:delete, event) %>
            <%= link_to event, class: 'ms-3', 'aria-label': t('event.links.delete'),
                               data: { turbo_method: :delete,
                                       turbo_confirm: t('event.forms.confirmation.deletion') } do %>
              <i class='fa fa-trash'></i>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
<%= render partial: 'shared/pagination', locals: { resource: events } %>
