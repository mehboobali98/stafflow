<%= render(PageHeaderComponent.new(title: local_assigns[:heading])) %>

<%= form_with model: @event, id: 'event_form', local: true,
              html: { data: { controller: 'event-date',
                              action: 'submit->event-date#validate',
                              'event-date-message-value': t('event.messages.error.invalid_year_alert') } } do |form| %>
  <%= render(CardComponent.new(class: 'form-card')) do %>
    <%= render(FormFieldComponent.new(form: form, attribute: :name, label: t('event.forms.labels.event_name'),
                                      required: true,
                                      placeholder: t('event.forms.placeholders.event_name'))) %>
    <div class="row g-3">
      <div class="col-sm-6">
        <%= render(FormFieldComponent.new(form: form, attribute: :event_date, as: :date_field,
                                          label: t('event.forms.labels.event_date'), id: 'event_date',
                                          value: set_event_date(@event.starts_at, local_assigns[:event_date]),
                                          required: true)) %>
      </div>
      <div class="col-sm-6">
        <%= render(FormFieldComponent.new(form: form, attribute: :event_time, as: :time_field,
                                          label: t('event.forms.labels.event_time'),
                                          value: extract_time(@event.starts_at), required: true)) %>
      </div>
    </div>
    <%= render(ButtonComponent.new(type: 'submit')) { t('form.button.submit') } %>
  <% end %>
<% end %>
