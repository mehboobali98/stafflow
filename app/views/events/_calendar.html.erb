<%= month_calendar events: @events do |date, events| %>
  <div class="d-flex flex-row justify-content-between">
    <%= date.day %>
    <%= link_to "+", new_event_path(event_date: date), class: 'text-sm text-primary' if date >= DateTime.now.to_date %>
  </div>
  <% events.each do |event| %>
    <%= link_to truncate_event_name(event.name), event, class: 'event-link' %>
  <% end %>
<% end %>