<div class="container">
  <div class="row justify-content-center">
    <div class="col-4">
      <h1> <%= heading %></h1>
      <% if event.errors.any? %>
        <div>
          <ul>
            <% event.errors.full_messages.each do |message| %>
              <li class='text-danger'><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= form_with model: event, local:true, :html => {'class' => 'card p-3 bg-light'} do |form| %>
        <div class="form-group mb-3">
          <%= form.label :name, I18n.t('event.forms.labels.event_name') %>
          <%= form.text_field :name, required: true, class: 'form-control', placeholder: I18n.t('event.forms.placeholders.event_name')%>
        </div>
        <div class="input-group mb-3 row">
          <div class="col-md-6">
            <%= form.label :event_start_date, I18n.t('event.forms.labels.event_date') %>
            <%= form.date_field :event_start_date, required: true, class: "form-control"%>
          </div>
          <div class="col-md-6">
            <%= form.label :event_start_time, I18n.t('event.forms.labels.event_time') %>
            <%= form.time_field :event_start_time, required: true, class: "form-control"%>
          </div>
        </div>
        <div>
          <%= form.submit class: 'card-link btn btn-primary'%>
        </div>
      <% end %>
    </div>
  </div>
</div>