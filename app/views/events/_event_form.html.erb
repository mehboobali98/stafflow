<%= form_with model: event do |form| %>
  <div>
    <%= form.label :name , 'Event name' %><br>
    <%= form.text_field :name, placeholder: "Enter event name"%>
  </div>
  <div>
    <span>
      <%= form.date_field :start_date_str %>
    </span>
    <span>
      <%= form.time_field :start_time_str %><br>
    </span>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>