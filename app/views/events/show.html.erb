<h1><%= @event.name %></h1>
<p><%= @event.start_time %></p>
<p><%= @event.end_time %></p>
<ul>
  <li><%= link_to "Edit", edit_event_path(@event) %></li>
  <li><%= link_to "Destroy", event_path(@event),
                  method: :delete,
                  data: { confirm: "Are you sure?" } %></li>
</ul>