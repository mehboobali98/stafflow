<div class="sidebar" data-sidebar-target="panel">
  <div class="logo-content">
    <div class="logo">
      <%= render(IconComponent.new(:'people-fill')) %>
      <div class="logo-name"><%= t('appname') %></div>
    </div>
    <%= render(IconComponent.new(:list, class: 'css-sidebar-toggle', id: 'sidebar_toggle_btn',
                                 label: t('sidebar.toggle'),
                                 data: { action: 'click->sidebar#toggle' })) %>
  </div>
  <ul>
    <li>
      <%= link_to dashboard_path do %>
        <%= render(IconComponent.new(:'grid-3x3')) %>
        <span class="links-name"><%= t('sidebar.dashboard') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to members_path do %>
        <%= render(IconComponent.new(:'person')) %>
        <span class="links-name"><%= t('sidebar.users') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to departments_path do %>
        <%= render(IconComponent.new(:'building')) %>
        <span class="links-name"><%= t('sidebar.departments') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to designations_path do %>
        <%= render(IconComponent.new(:'building')) %>
        <span class="links-name"><%= t('sidebar.designations') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to events_path do %>
        <%= render(IconComponent.new(:'calendar-event')) %>
        <span class="links-name"><%= t('sidebar.events') %></span>
      <% end %>
    </li>
    <% unless current_user.account_owner? %>
      <li>
        <%= link_to member_payrolls_path(current_user) do %>
          <%= render(IconComponent.new(:'receipt')) %>
          <span class="links-name"><%= t('sidebar.payroll') %></span>
        <% end %>
      </li>
    <% end %>
    <li>
      <%= link_to leaves_path do %>
        <%= render(IconComponent.new(:'list-task')) %>
        <span class="links-name"><%= t('sidebar.leave') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to display_calendar_events_path do %>
        <%= render(IconComponent.new(:'calendar-plus')) %>
        <span class="links-name"><%= t('sidebar.calendar') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to analytics_path do %>
        <%= render(IconComponent.new(:'graph-up')) %>
        <span class="links-name"><%= t('sidebar.analytics') %></span>
      <% end %>
    </li>
    <% if current_user.account_owner? || current_user.hr? %>
      <li>
        <%= link_to settings_path do %>
          <%= render(IconComponent.new(:'gear-wide-connected')) %>
          <span class="links-name"><%= t('sidebar.settings') %></span>
        <% end %>
      </li>
    <% end %>
    <li>
      <%= link_to edit_password_members_path do %>
        <%= render(IconComponent.new(:'unlock')) %>
        <span class="links-name"><%= t('sidebar.cp') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to member_path(current_user) do %>
        <%= render(IconComponent.new(:'person-gear')) %>
        <span class="links-name"><%= t('sidebar.view_profile') %></span>
      <% end %>
    </li>
    <li>
      <%= link_to destroy_user_session_url, data: { turbo_method: :delete } do %>
        <%= render(IconComponent.new(:'box-arrow-right', id: 'log-out')) %>
        <span class="links-name"><%= t('sidebar.logout') %></span>
      <% end %>
    </li>
  </ul>
</div>