<% binding.pry %>
<% if notice %>
  <div class="row justify-content-center">
    <div class="alert alert-success col-md-4" role="alert">
      <p class="text-center">
        <%= notice %>
      </p>
    </div>
  </div>
<% elsif alert %>
  <div class="row justify-content-center">
    <div class="alert alert-danger col-md-4" role="alert">
      <li class="text-center">
        <%= alert %>
      </li>
    </div>
  </div>
<% end %>
