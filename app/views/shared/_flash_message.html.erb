<div class="row justify-content-center">
  <% flash.each do |error_type, error_message| %>
    <% if error_message.is_a?(Array) %>
      <ul>
        <% error_message.each do |message| %>
          <li class="text-center"><%= message %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center"><%= error_message %></p>
    <% end %>
  <% end %>
</div>