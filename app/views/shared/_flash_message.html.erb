<div class="row justify-content-center">
  <% flash.each do |message_type, error_message| %>
    <div class="<%= flash_class(message_type) %> col-md-4">
      <a href="#" data-dismiss="alert" class="close far fa-times-circle"></a>
      <% if error_message.is_a?(Array) %>
        <ul>
          <% error_message.each do |message| %>
            <li class="text-center"><%= message %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-center"><%= error_message %></p>
      <% end %>
    </div>
  <% end %>
</div>