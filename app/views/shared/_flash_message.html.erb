<div class="row justify-content-center">
  <% if flash[:notice] %>
    <div class="alert alert-success col-md-4" role="alert">
      <p class="text-center">
        <%= notice %>
      </p>
    </div>
  <% elsif flash[:errors] %>
    <div class="alert alert-danger col-md-4" role="alert">
      <% flash[:errors].each do |error| %>
        <li class="text-center">
          <%= error %>
        </li>
      <% end %>
    </div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger col-md-4" role="alert">
      <p class="text-center">
        <%= alert %>
      </p>
    </div>
  <% end %>
</div>