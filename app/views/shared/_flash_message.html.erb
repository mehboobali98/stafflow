<% flash.each do |message_type, error_message| %>
  <div class="<%= add_flash_bootstrap_class(message_type) %> alert-dismissible fade show text-center flash-message mt-2 mx-2" role="alert" >
    <% if error_message.is_a?(Array) %>
      <ul>
        <% error_message.each do |message| %>
          <li class="text-center"><%= message %></li>
        <% end %>
      </ul>
    <% else %>
      <p><%= error_message %></p>
    <% end %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>