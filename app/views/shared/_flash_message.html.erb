<% flash.each do |message_type, error_message| %>
  <div class="<%= add_flash_bootstrap_class(message_type) %> alert-dismissible fade show text-center flash-message m-4" role="alert" >
    <% if error_message.is_a?(Array) %>
      <p><%= error_message.first %></p>
    <% else %>
      <p><%= error_message %></p>
    <% end %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>