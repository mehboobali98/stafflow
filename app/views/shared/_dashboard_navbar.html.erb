<%= javascript_pack_tag 'navbar', 'data-turbolinks-track': 'reload' %>
<nav class="navbar navbar-expand-lg navbar-light dashboard-navbar">
  <div class="container-fluid">
    <div class="navbar-brand"><%= @current_company&.name %></div>
    <div class="d-flex justify-content-end collapse navbar-collapse" id="navbarSupportedContent">
      <form class="d-flex">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
        <button class="btn btn-dark" type="submit"><%= t('common.search') %></button>
      </form>
      <div class="notification-container">
        <%= link_to notifications_path, class: 'nav-item text-white' do %>
          <i class='fa fa-bell fa-lg'>
          </i><span class='counter counter-lg border border-danger p-1 ms-1 bg-danger ps-2 pe-2' id='notifications_count'></span>
        <% end %>
      </div>
    </div>
  </div>
</nav>