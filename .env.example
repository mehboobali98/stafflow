# Copy to .env and adjust. docker compose reads this file automatically.

# Host port the app is published on. Change it if 3000 is already taken.
WEB_PORT=3000

# MySQL. These are consumed by both the db service and the app.
DATABASE_NAME=stafflow_development
DATABASE_PASSWORD=stafflow

# Address outbound mail is sent from.
STAFFLOW_MAILER_FROM=noreply@stafflow.example

# Domain shown after the subdomain on the sign-up form.
STAFFLOW_PORTAL_DOMAIN=stafflow.example
